    function getFeedbackAttemptLabel(attemptNo) {
      var number = Number(attemptNo);
      if (!Number.isFinite(number) || number < 1) return '章节测验';
      number = Math.floor(number);
      var labels = ['', '首测', '第二次测验', '第三次测验', '第四次测验', '第五次测验', '第六次测验', '第七次测验', '第八次测验', '第九次测验', '第十次测验'];
      return labels[number] || '第' + number + '次测验';
    }

    function normalizeTeachingFeedback(item) {
      var attemptNo = item.attemptNo;
      if ((attemptNo === undefined || attemptNo === null || attemptNo === '') && item.content) {
        var attemptMatch = String(item.content).match(/第(\d+)次测验/);
        if (attemptMatch) attemptNo = Number(attemptMatch[1]);
        if (/首测/.test(String(item.content))) attemptNo = 1;
      }
      var course = item.course || item.courseName || '基础课程';
      var chapter = item.chapter || item.chapterName || '';
      var content = item.content || item.detail || '学生提交了本次章节测验反馈。';
      content = String(content).replace(/^\[(?:首测|第\d+次测验)(?:｜[^]]*)?\]\s*/, '');
      return {
        time: item.time || item.createdAt || '刚刚',
        student: item.student || item.studentName || '当前学生',
        course: course,
        attemptNo: Number(attemptNo) || 0,
        attempt: getFeedbackAttemptLabel(attemptNo),
        type: item.type || '课程反馈',
        content: content
      };
    }

    function getTeachingFeedbackGroupKey(item) {
      return [item.student, item.course].join('｜');
    }

    function getTeachingFeedbackRecords() {
      var stored = readStudentFeedback().map(normalizeTeachingFeedback);
      var storedKeys = {};
      stored.forEach(function(item) {
        storedKeys[[item.student, item.course, item.attemptNo].join('｜')] = true;
      });
      var samples = defaultFeedback.map(normalizeTeachingFeedback).filter(function(item) {
        return !storedKeys[[item.student, item.course, item.attemptNo].join('｜')];
      });
      return stored.concat(samples);
    }

    function renderTeachingFeedback() {
      var target = document.getElementById('feedbackRows');
      if (!target) return;
      var grouped = {};
      getTeachingFeedbackRecords().forEach(function(item) {
        var key = getTeachingFeedbackGroupKey(item);
        if (!grouped[key]) {
          grouped[key] = {
            student: item.student,
            course: item.course,
            records: []
          };
        }
        grouped[key].records.push(item);
      });
      var groups = Object.keys(grouped).map(function(key) {
        var group = grouped[key];
        group.records.sort(function(a, b) {
          if (a.attemptNo !== b.attemptNo) return a.attemptNo - b.attemptNo;
          return String(a.time).localeCompare(String(b.time));
        });
        return group;
      });
      target.innerHTML = groups.map(function(group) {
        var records = group.records;
        var stack = function(render) {
          return '<div class="feedback-stack">' + records.map(function(item) {
            return '<div class="feedback-stack-item">' + render(item) + '</div>';
          }).join('') + '</div>';
        };
        return '<tr>'
          + '<td class="feedback-group-cell">' + stack(function(item) { return escapeHtml(item.time); }) + '</td>'
          + '<td class="feedback-group-cell"><strong>' + escapeHtml(group.student) + '</strong></td>'
          + '<td class="feedback-group-cell"><strong>' + escapeHtml(group.course) + '</strong></td>'
          + '<td class="feedback-group-cell feedback-attempt-stack">' + stack(function(item) { return '<span class="status info">' + escapeHtml(item.attempt) + '</span>'; }) + '</td>'
          + '<td class="feedback-group-cell">' + stack(function(item) { return '<span class="status info">' + escapeHtml(item.type) + '</span>'; }) + '</td>'
          + '<td class="feedback-group-cell feedback-content-stack">' + stack(function(item) { return escapeHtml(item.content); }) + '</td>'
          + '</tr>';
      }).join('');
    }

