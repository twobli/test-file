                    var wrong = question.result === '答错';
                    return '<div class="student-question-item' + (wrong ? ' wrong' : '') + '">'
                      + '<strong>第' + question.no + '题 · ' + escapeHtml(question.result) + ' · ' + escapeHtml(question.title) + '</strong>'
                      + '<p>你的答案：' + escapeHtml(question.userAnswer) + '</p>'
                      + '<p>正确答案：' + escapeHtml(question.correctAnswer) + '</p>'
                      + '<p>绑定知识点：' + escapeHtml(question.knowledge) + '</p>'
                      + '<p>解析：' + escapeHtml(question.analysis) + '</p>'
                      + '</div>';
                  }).join('')
                  + '</div>'
                : '<p class="muted">该次测验暂未同步答题明细。</p>';
              return '<div class="student-attempt-item">'
                + '<div class="student-course-head"><strong>' + (attempt.chapterTitle ? escapeHtml(attempt.chapterTitle) + ' · ' : '') + escapeHtml(attempt.label) + '：' + attempt.score + '%</strong><span class="muted">' + escapeHtml(attempt.date) + '</span></div>'
                + questionMarkup
                + '</div>';
            }).join('')
            + '</div>'
          : '<p>章节测验：' + escapeHtml(getCourseQuizSummary(course)) + '</p>';
        return '<div class="student-detail-item">'
          + '<div class="student-course-head"><strong>' + escapeHtml(course.name) + '</strong><span class="status ' + statusClass(course.state) + '">' + progress + '%</span></div>'
          + '<div class="progress"><span style="width:' + progress + '%"></span></div>'
          + '<p>学习进度：' + progress + '%<br>章节测验所属章节：' + escapeHtml(course.quizChapter || '课程完成后按章节开放') + '<br>学习状态：' + escapeHtml(course.state) + '</p>'
          + attemptMarkup
          + '</div>';
      }).join('');
      var body = '<div class="rules" style="margin-bottom:14px;"><div class="rule-box"><b>' + escapeHtml(student.name) + '</b><p>' + escapeHtml(student.group) + ' · 共学习 ' + student.courses.length + ' 门课程</p></div></div>'
        + '<div class="student-detail-list">' + courseMarkup + '</div>';
      openTeachingModal('查看学员详情 - ' + student.name, '只读查看该学员各课程学习进度，以及每一次已完成章节测验的成绩、答题明细、知识点和解析。', body, '关闭', closeDrawer);
    }

    function openTeachingShelf(action, code) {
      var item = getTeachingItem(code);
      var isUp = action === 'up';
      var title = (isUp ? '重新上架阅片题 - ' : '下架阅片题 - ') + code;
      var desc = isUp ? '重新确认有效日期后，题目会按时间规则进入前台展示。' : '下架后该题会立即从前台阅片列表隐藏。';
      var body = '<div class="confirm-panel">'
        + '<div class="confirm-warning"><b>' + (isUp ? '确认重新上架' : '确认下架') + '</b><p>' + desc + '</p></div>'
        + '<div class="rules"><div class="rule-box"><b>题目</b><p>' + item.title + '</p></div><div class="rule-box"><b>当前状态</b><p>' + item.status + '</p></div><div class="rule-box"><b>有效日期</b><p>' + item.date + '</p></div></div>'
        + '<div class="form-field"><label>' + (isUp ? '重新上架说明' : '下架原因') + '</label><textarea>' + (isUp ? '已确认题目内容、影像和有效日期，可重新进入前台展示。' : '发现题目内容或影像需要调整，先下架避免前台继续展示。') + '</textarea></div>'
        + '</div>';
      openTeachingModal(title, desc, body, isUp ? '确认重新上架' : '确认下架', function() {
        closeDrawer();
        showToast((isUp ? '已重新上架 ' : '已下架 ') + code + '，前台列表将按有效期规则刷新。');
      });
    }

    function openDrawer(title, desc, template) {
      document.getElementById('drawerTitle').textContent = title;
      document.getElementById('drawerDesc').textContent = desc;
      document.getElementById('drawerBody').innerHTML = drawerTemplates[template] || '<p>暂无配置项。</p>';
      document.getElementById('drawerMask').classList.add('open');
      var drawer = document.getElementById('drawer');
      drawer.classList.add('modal-center', 'open');
      if (template === 'case-loop' || template === 'case-ai') {
        setDrawerPrimary('关闭', closeDrawer);
      } else if (template === 'exam') {
        setDrawerPrimary('确认创建试卷', saveDrawer);
      } else {
        setDrawerPrimary('保存', saveDrawer);
      }
      if (template === 'teaching-question') initTeachingQuestionForm();
      if (template === 'exam') {
        syncExamFrameworkOptions();
        initExamQuestionBuilder();
      }
    }

    function closeDrawer() {
      document.getElementById('drawerMask').classList.remove('open');
      var drawer = document.getElementById('drawer');
      drawer.classList.remove('open');
      drawer.classList.remove('modal-center');
    }

    function saveDrawer() {
      if (document.querySelector('#drawerBody [data-exam-name]') && !validateExamBeforeSave()) return;
      closeDrawer();
      showToast('配置已保存，相关前台状态将在下一次刷新时同步。');
    }

    function showToast(text) {
      var toast = document.getElementById('toast');
      toast.textContent = text;
      toast.classList.add('show');
      window.clearTimeout(showToast.timer);
      showToast.timer = window.setTimeout(function() {
        toast.classList.remove('show');
      }, 2600);
    }

    window.addEventListener('storage', function(event) {
      if (event.key === FRONTEND_QUIZ_STORAGE_KEY || event.key === 'life_med_user') {
        renderStudents();
      }
    });

    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) renderStudents();
    });

    renderCourses();
    renderKnowledgeBindings();
    renderStudents();
    renderTeachingFeedback();
    renderExams();
    renderLiterature();
    initNav();
    initTabs();
    setStudentEntryVisibility(document.querySelector('.section.active').id);
  </script>
</body>
</html>
