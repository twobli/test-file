    function activateSection(target, updateHash) {
      if (!target || !document.getElementById(target) || !sectionMeta[target]) {
        target = 'courses';
      }
      document.querySelectorAll('.nav-item').forEach(function(item) { item.classList.remove('active'); });
      document.querySelectorAll('.section').forEach(function(section) { section.classList.remove('active'); });
      var activeNav = document.querySelector('.nav-item[data-section="' + target + '"]');
      if (activeNav) activeNav.classList.add('active');
      document.getElementById(target).classList.add('active');
      document.getElementById('pageTitle').textContent = sectionMeta[target][0];
      document.getElementById('pageDesc').textContent = sectionMeta[target][1];
      setStudentEntryVisibility(target);
      if (updateHash && window.location.hash !== '#' + target) {
        history.pushState(null, '', '#' + target);
