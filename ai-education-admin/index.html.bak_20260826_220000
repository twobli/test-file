    function syncExamFrameworkOptions() {
      var stageSelect = document.querySelector('#drawerBody [data-exam-stage]');
      var typeSelect = document.querySelector('#drawerBody [data-exam-type]');
      var targetSelect = document.querySelector('#drawerBody [data-exam-target]');
      if (!stageSelect || !typeSelect || !targetSelect) return;
      var stage = stageSelect.value;
      var examType = typeSelect.value;
      typeSelect.querySelectorAll('option[data-exam-stage]').forEach(function(option) {
        var visible = option.getAttribute('data-exam-stage') === stage;
        option.hidden = !visible;
        option.disabled = !visible;
      });
      var currentType = typeSelect.querySelector('option:checked');
      if (!currentType || currentType.disabled) {
        var firstType = typeSelect.querySelector('option[data-exam-stage="' + stage + '"]:not([disabled])');
        if (firstType) {
          typeSelect.value = firstType.value;
          examType = firstType.value;
        }
      }
      var visibleOptions = [];
      targetSelect.querySelectorAll('option[data-exam-stage]').forEach(function(option) {
        var visible = option.getAttribute('data-exam-stage') === stage && option.getAttribute('data-exam-type') === examType;
        option.hidden = !visible;
        option.disabled = !visible;
        if (visible) visibleOptions.push(option);
      });
      var current = targetSelect.value;
      if (!visibleOptions.some(function(option) { return option.value === current; })) {
        targetSelect.value = visibleOptions.length ? visibleOptions[0].value : '';
      }
    }

