    function validateExamBeforeSave() {
      var name = document.querySelector('#drawerBody [data-exam-name]');
      var target = document.querySelector('#drawerBody [data-exam-target]');
      var cards = document.querySelectorAll('#drawerBody [data-exam-question-card]');
      if (!name || !name.value.trim()) {
        showToast('请先填写试卷名称。');
        return false;
      }
      if (!target || !target.value) {
        showToast('请先选择考核范围。');
        return false;
      }
      if (!cards.length) {
        showToast('请至少添加1道试题。');
        return false;
      }
      for (var i = 0; i < cards.length; i++) {
        var card = cards[i];
        var stem = card.querySelector('[data-question-stem]');
        var score = card.querySelector('[data-question-score]');
        var answer = card.querySelector('[data-question-answer]');
        var knowledge = card.querySelector('[data-question-knowledge]');
        var type = card.querySelector('[data-question-type]');
        var options = card.querySelector('[data-question-options]');
        var selectedKnowledge = knowledge ? Array.prototype.filter.call(knowledge.options, function(option) { return option.selected; }) : [];
        if (!stem || !stem.value.trim()) {
          showToast('第' + (i + 1) + '题还没有填写题干。');
          return false;
        }
        if (!score || !score.value || Number(score.value) <= 0) {
          showToast('第' + (i + 1) + '题的分数必须大于0。');
          return false;
        }
        if (!selectedKnowledge.length) {
          showToast('第' + (i + 1) + '题请选择关联知识点。');
          return false;
        }
        if (type && (type.value === '单选题' || type.value === '多选题') && (!options || !options.value.trim())) {
          showToast('第' + (i + 1) + '题请填写选项。');
          return false;
        }
        if (!answer || !answer.value.trim()) {
          showToast('第' + (i + 1) + '题还没有填写答案或评分说明。');
          return false;
        }
      }
      return true;
    }

    function renderLiterature() {
      var keywordEl = document.getElementById('literatureKeyword');
      if (!keywordEl) return;
      var keyword = keywordEl.value.trim().toLowerCase();
      var journal = document.getElementById('literatureJournalFilter').value;
