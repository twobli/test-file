      var type = typeSelect.value;
      var isChoice = type === '单选题' || type === '多选题';
      if (choiceField) choiceField.style.display = isChoice ? '' : 'none';
      if (choiceLabel) choiceLabel.textContent = type === '多选题' ? '多选题选项' : '单选题选项';
      if (answerLabel) {
        answerLabel.textContent = type === '代码题' ? '参考代码与判分说明'
          : (type === '病例分析题' ? '参考答案、评分点与解析' : '正确答案与解析');
