<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>生命医学AI教育后台管理系统</title>
  <style>
    :root {
      --bg: #f4f7fb;
      --panel: #ffffff;
      --panel-soft: #f8fbff;
      --text: #1f2a37;
      --muted: #6b7280;
      --line: #dfe6ef;
      --primary: #1565c0;
      --primary-strong: #0d47a1;
      --teal: #00897b;
      --green: #2e7d32;
      --amber: #b7791f;
      --red: #c62828;
      --violet: #6a1b9a;
      --shadow: 0 14px 32px rgba(31, 42, 55, 0.08);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      background: var(--bg);
      font-family: "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
      letter-spacing: 0;
    }

    a { color: inherit; text-decoration: none; }
    button, input, select, textarea { font: inherit; letter-spacing: 0; }

    .admin-shell {
      display: grid;
      grid-template-columns: 248px minmax(0, 1fr);
      min-height: 100vh;
    }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: auto;
      background: #102033;
      color: #dbeafe;
      border-right: 1px solid rgba(255,255,255,0.08);
      padding: 18px 14px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 10px 18px;
      border-bottom: 1px solid rgba(255,255,255,0.12);
      margin-bottom: 12px;
    }

    .brand-mark {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border-radius: 8px;
      background: linear-gradient(135deg, #1e88e5, #00a896);
      color: #fff;
      font-weight: 800;
      font-size: 13px;
    }

    .brand-title { display: grid; gap: 2px; }
    .brand-title strong { color: #fff; font-size: 15px; }
    .brand-title span { color: #a9bdd6; font-size: 12px; }

    .nav-group-title {
      padding: 14px 10px 8px;
      color: #8fb0d3;
      font-size: 12px;
    }

    .nav-item {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      border: 0;
      border-radius: 8px;
      padding: 10px 12px;
      margin: 3px 0;
      background: transparent;
      color: #cfe1f7;
      text-align: left;
      cursor: pointer;
      transition: background .2s ease, color .2s ease;
    }

    .nav-item:hover { background: rgba(255,255,255,0.08); color: #fff; }
    .nav-item.active { background: #ffffff; color: #102033; font-weight: 700; }
    .nav-icon { width: 18px; text-align: center; color: currentColor; }

    .main {
      min-width: 0;
      padding: 22px 26px 42px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 18px;
      margin-bottom: 18px;
    }

    .eyebrow {
      margin: 0 0 6px;
      color: var(--primary);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
    }

    h1 {
      margin: 0 0 8px;
      font-size: 26px;
      line-height: 1.25;
      font-weight: 800;
    }

    .page-desc {
      margin: 0;
      color: var(--muted);
      max-width: 900px;
      line-height: 1.65;
      font-size: 14px;
    }

    .top-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .btn {
      min-height: 36px;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--text);
      border-radius: 8px;
      padding: 8px 13px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      white-space: nowrap;
      transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }

    .btn:hover {
      transform: translateY(-1px);
      border-color: #b7c7d9;
      box-shadow: 0 8px 18px rgba(31,42,55,0.08);
    }

    .btn.primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    .btn.green { background: var(--green); border-color: var(--green); color: #fff; }
    .btn.warning { background: #fff8e1; border-color: #f0c36d; color: #865d13; }
    .btn.danger { background: #fff1f1; border-color: #ffc9c9; color: var(--red); }
    .btn.small { min-height: 30px; padding: 5px 9px; font-size: 12px; }

    .section { display: none; }
    .section.active { display: block; }

    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin: 14px 0;
      flex-wrap: wrap;
    }

    .filters {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .input, .select {
      height: 36px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
      color: var(--text);
      padding: 0 11px;
      min-width: 132px;
      outline: none;
    }

    .input { min-width: 210px; }
    .input:focus, .select:focus, textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(21,101,192,0.12); }
    .knowledge-select { height: 118px; padding: 8px 11px; }

    .grid { display: grid; gap: 14px; }
    .grid.kpi { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .grid.two { grid-template-columns: minmax(0, 1.45fr) minmax(320px, .85fr); }
    .grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 8px;
      box-shadow: var(--shadow);
    }

    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      padding: 16px 18px 12px;
      border-bottom: 1px solid var(--line);
    }

    .panel-title {
      margin: 0;
      font-size: 16px;
      font-weight: 800;
    }

    .panel-subtitle {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.55;
    }

    .panel-body { padding: 16px 18px 18px; }

    .course-builder { display: grid; gap: 14px; }
    .course-builder-note {
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #f8fbff;
      color: var(--muted);
      padding: 12px 14px;
      line-height: 1.6;
      font-size: 13px;
    }
    .course-chapter-list { display: grid; gap: 14px; }
    .chapter-card {
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
      padding: 14px;
      display: grid;
      gap: 12px;
    }
    .chapter-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      align-items: flex-start;
    }
    .chapter-title-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      min-width: 0;
    }
    .chapter-tag {
      white-space: nowrap;
      font-weight: 800;
      color: var(--primary);
    }
    .chapter-name { min-width: 260px; flex: 1; }
    .section-list { display: grid; gap: 12px; }
    .section-card {
      border: 1px dashed #cfd9ea;
      border-radius: 8px;
      background: #f9fbff;
      padding: 12px;
      display: grid;
      gap: 12px;
    }
    .section-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
    }
    .section-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .section-grid .form-field textarea { min-height: 118px; }
    .section-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      flex-wrap: wrap;
    }
    .chapter-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      flex-wrap: wrap;
    }

    .kpi-card {
      padding: 16px;
      min-height: 124px;
      display: grid;
      gap: 10px;
    }

    .kpi-card .label { color: var(--muted); font-size: 13px; }
    .kpi-card .value { font-size: 27px; font-weight: 800; line-height: 1; }
    .kpi-card .note { color: var(--muted); font-size: 12px; line-height: 1.5; }

    .kpi-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .metric-dot {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 8px;
      background: #e8f2ff;
      color: var(--primary);
      font-weight: 800;
      font-size: 13px;
    }

    .metric-dot.green { background: #e7f5ee; color: var(--green); }
    .metric-dot.amber { background: #fff4df; color: var(--amber); }
    .metric-dot.violet { background: #f3e8ff; color: var(--violet); }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 24px;
      padding: 3px 8px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      border: 1px solid transparent;
      white-space: nowrap;
    }

    .status.ok { color: var(--green); background: #eaf7ee; border-color: #cbe8d2; }
    .status.wait { color: var(--amber); background: #fff8e1; border-color: #f1d493; }
    .status.info { color: var(--primary); background: #e8f2ff; border-color: #c5dcf6; }
    .status.bad { color: var(--red); background: #fff1f1; border-color: #ffd1d1; }
    .status.gray { color: #596579; background: #eef2f7; border-color: #d9e1ea; }

    .table-wrap { width: 100%; overflow: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 860px; }
    th, td {
      padding: 12px 12px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
      font-size: 13px;
      line-height: 1.5;
    }
    th {
      color: #435066;
      background: #f8fbff;
      font-weight: 800;
      white-space: nowrap;
    }
    td .muted { color: var(--muted); }
    .table-actions { display: flex; gap: 7px; flex-wrap: wrap; }
    .feedback-group-cell { vertical-align: top; }
    .feedback-stack {
      display: grid;
      gap: 8px;
      min-width: 120px;
    }
    .feedback-stack-item {
      min-height: 30px;
      display: flex;
      align-items: center;
      padding: 4px 0;
      line-height: 1.45;
    }
    .feedback-stack-item + .feedback-stack-item {
      border-top: 1px solid #edf1f6;
      padding-top: 8px;
    }
    .feedback-attempt-stack .feedback-stack-item {
      justify-content: flex-start;
    }
    .feedback-content-stack {
      min-width: 360px;
    }

    .kg-type {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 800;
      white-space: nowrap;
    }
    .kg-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }
    .kg-dot.disease { background: #e74c3c; }
    .kg-dot.drug { background: #2ecc71; }
    .kg-dot.surgery { background: #e67e22; }
    .kg-dot.exam { background: #3498db; }
    .kg-dot.symptom { background: #9b59b6; }
    .kg-dot.reasoning { background: #e67e22; box-shadow: inset 0 0 0 2px #fff; outline: 1px dashed #e67e22; }
    .relation-route {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap;
      font-weight: 700;
    }
    .relation-arrow {
      color: var(--primary);
      font-weight: 900;
    }
    .kg-mini-graph {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: center;
      gap: 10px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--panel-soft);
    }
    .kg-mini-node {
      min-height: 72px;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 10px;
      border-radius: 8px;
      color: #fff;
      font-weight: 800;
      line-height: 1.35;
    }
    .kg-mini-node.disease { background: #e74c3c; }
    .kg-mini-node.drug { background: #2ecc71; }
    .kg-mini-node.surgery { background: #e67e22; }
    .kg-mini-node.exam { background: #3498db; }
    .kg-mini-node.symptom { background: #9b59b6; }
    .kg-mini-edge {
      display: grid;
      gap: 6px;
      color: var(--muted);
      text-align: center;
      font-size: 12px;
    }
    .kg-mini-edge b { color: var(--primary); }

    .stars { color: #f6ad24; letter-spacing: 0; white-space: nowrap; }
    .mono { font-family: Consolas, "Courier New", monospace; }

    .progress {
      position: relative;
      height: 8px;
      border-radius: 999px;
      background: #e7edf5;
      overflow: hidden;
      min-width: 110px;
    }
    .progress span {
      display: block;
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #1e88e5, #00a896);
    }
    .progress-label { margin-top: 5px; color: var(--muted); font-size: 12px; }

    .student-course-list {
      display: grid;
      gap: 10px;
      min-width: 420px;
    }
    .student-course-item {
      padding: 9px 10px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fbfdff;
    }
    .student-course-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .student-course-head strong { font-size: 13px; }
    .student-course-progress { margin-top: 7px; }
    .student-course-progress .progress { min-width: 180px; }
    .student-course-meta {
      margin-top: 6px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }
    .student-detail-list {
      display: grid;
      gap: 12px;
    }
    .student-detail-item {
      padding: 13px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fbfdff;
    }
    .student-detail-item strong { font-size: 14px; }
    .student-detail-item .progress { margin-top: 9px; }
    .student-detail-item p {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.55;
    }
    .student-attempt-list {
      display: grid;
      gap: 8px;
      margin-top: 10px;
    }
    .student-attempt-item {
      padding: 9px 10px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }
    .student-attempt-item .student-course-head { margin-bottom: 4px; }
    .student-question-list {
      display: grid;
      gap: 8px;
      margin-top: 10px;
    }
    .student-question-item {
      padding: 10px;
      border-left: 3px solid var(--primary);
      background: #f8fbff;
      font-size: 12px;
      line-height: 1.55;
    }
    .student-question-item.wrong { border-left-color: var(--red); }
    .student-question-item strong { display: block; margin-bottom: 4px; }
    .student-question-item p { margin: 2px 0; color: var(--muted); }

    .logic-flow {
      display: grid;
      grid-template-columns: repeat(6, minmax(120px, 1fr));
      gap: 10px;
      overflow: auto;
      padding-bottom: 4px;
    }

    .flow-step {
      position: relative;
      min-height: 110px;
      padding: 14px;
      border: 1px solid var(--line);
      background: var(--panel-soft);
      border-radius: 8px;
    }

    .flow-step b { display: block; margin-bottom: 8px; font-size: 14px; }
    .flow-step p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.5; }

    .list { display: grid; gap: 10px; }
    .list-item {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 10px;
      align-items: start;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }
    .list-item strong { display: block; margin-bottom: 4px; font-size: 13px; }
    .list-item p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.5; }

    .check-icon {
      width: 24px;
      height: 24px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: #fff;
      background: var(--primary);
      font-size: 12px;
      font-weight: 800;
    }

    .check-icon.warn { background: var(--amber); }
    .check-icon.ok { background: var(--green); }
    .check-icon.bad { background: var(--red); }

    .rules {
      display: grid;
      gap: 10px;
    }

    .rule-box {
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }
    .rule-box b { display: block; margin-bottom: 6px; }
    .rule-box p { margin: 0; color: var(--muted); line-height: 1.55; font-size: 13px; }

    .chapter-tree {
      display: grid;
      gap: 10px;
      padding-left: 4px;
    }
    .chapter-node {
      display: grid;
      grid-template-columns: 24px 1fr auto;
      gap: 10px;
      align-items: center;
      padding: 11px 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }
    .chapter-line {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      border: 4px solid #d5e2f0;
      background: #fff;
    }
    .chapter-line.done { border-color: var(--green); }
    .chapter-line.pending { border-color: var(--amber); }
    .chapter-line.locked { border-color: #b8c2cf; }
    .chapter-node b { font-size: 13px; }
    .chapter-node span { color: var(--muted); font-size: 12px; }

    .tabs {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      padding: 4px;
      background: #eaf0f7;
      border-radius: 8px;
    }
    .tab {
      border: 0;
      border-radius: 7px;
      background: transparent;
      padding: 8px 12px;
      cursor: pointer;
      color: #526071;
      font-weight: 700;
    }
    .tab.active { background: #fff; color: var(--primary); box-shadow: 0 4px 12px rgba(31,42,55,0.08); }

    .tab-pane { display: none; }
    .tab-pane.active { display: block; }

    .split-form {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .exam-question-builder {
      grid-column: 1 / -1;
      display: grid;
      gap: 12px;
      padding: 14px;
      border: 1px solid #cfe0f2;
      border-radius: 8px;
      background: #f7fbff;
    }
    .exam-question-builder-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }
    .exam-question-builder-head strong { font-size: 14px; }
    .exam-question-builder-head p { margin: 4px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
    .exam-question-list { display: grid; gap: 12px; }
    .exam-question-card {
      display: grid;
      gap: 12px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }
    .exam-question-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--line);
    }
    .exam-question-card-head strong { font-size: 13px; }
    .exam-question-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .btn.ai-question-btn {
      background: #0f766e;
      border-color: #0f766e;
      color: #fff;
    }
    .btn.ai-question-btn:hover {
      background: #0b625c;
      border-color: #0b625c;
    }
    .exam-question-card .question-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }
    .exam-question-card .wide { grid-column: 1 / -1; }
    .exam-question-card textarea { min-height: 76px; }
    .exam-question-card .code-answer { min-height: 150px; font-family: Consolas, Monaco, "Courier New", monospace; }
    .exam-question-total {
      display: inline-flex;
      align-items: center;
      min-height: 30px;
      padding: 5px 9px;
      border-radius: 6px;
      background: #eaf3ff;
      color: var(--primary);
      font-size: 12px;
      font-weight: 800;
    }
    .form-field { display: grid; gap: 6px; }
    .form-field label { color: #435066; font-size: 12px; font-weight: 800; }
    .form-hint {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }
    textarea {
      min-height: 84px;
      border: 1px solid var(--line);
      border-radius: 8px;
      resize: vertical;
      padding: 10px 11px;
      outline: none;
      color: var(--text);
    }

    .image-upload-grid {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .image-upload-card {
      display: grid;
      gap: 10px;
      padding: 12px;
      border: 1px dashed #b8c7d9;
      border-radius: 8px;
      background: #f8fbff;
    }
    .image-upload-card b {
      color: #1b2838;
      font-size: 13px;
    }
    .image-preview {
      display: grid;
      place-items: center;
      min-height: 150px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #eef4fb;
      color: var(--muted);
      font-size: 13px;
      overflow: hidden;
    }
    .image-preview img {
      width: 100%;
      height: 180px;
      object-fit: contain;
      background: #111827;
    }
    .answer-option {
      display: grid;
      grid-template-columns: 54px minmax(0, 1fr) 112px;
      gap: 10px;
      align-items: start;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }
    .answer-letter {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background: #e8f2ff;
      color: var(--primary);
      font-weight: 900;
    }
    .answer-fields {
      display: grid;
      gap: 8px;
    }
    .rich-editor {
      grid-column: 1 / -1;
      display: grid;
      gap: 8px;
    }
    .rich-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #f8fafc;
    }
    .rich-toolbar button,
    .rich-toolbar label {
      border: 1px solid var(--line);
      border-radius: 7px;
      background: #fff;
      padding: 7px 10px;
      color: #344054;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
    }
    .rich-toolbar input { display: none; }
    .rich-content {
      min-height: 260px;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
      line-height: 1.7;
      outline: none;
      overflow: auto;
    }
    .rich-content img {
      max-width: 100%;
      border-radius: 8px;
      border: 1px solid var(--line);
      margin: 10px 0;
    }
    .teaching-preview {
      display: grid;
      gap: 14px;
    }
    .preview-cover {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 12px;
    }
    .preview-image-box {
      min-height: 190px;
      border-radius: 8px;
      background:
        radial-gradient(circle at 46% 48%, rgba(244,129,66,.95) 0 12%, rgba(175,48,20,.94) 13% 30%, rgba(80,18,12,.96) 31% 58%, #220e12 59% 100%);
      position: relative;
      overflow: hidden;
    }
    .preview-image-box.oct {
      background:
        linear-gradient(180deg, #111827 0 12%, #b9c3d4 13% 30%, #667085 31% 43%, #f59f58 44% 54%, #4b5563 55% 68%, #111827 69% 100%);
    }
    .preview-image-box.doppler {
      background:
        radial-gradient(circle at 35% 45%, rgba(27,113,196,.9), transparent 28%),
        radial-gradient(circle at 62% 52%, rgba(220,38,38,.88), transparent 24%),
        linear-gradient(135deg, #0f172a, #64748b);
    }
    .preview-image-box.mri {
      background: radial-gradient(circle at 50% 42%, #e5e7eb 0 18%, #6b7280 19% 36%, #111827 37% 100%);
    }
    .preview-eye {
      position: absolute;
      top: 10px;
      left: 10px;
      padding: 4px 8px;
      border-radius: 999px;
      background: rgba(255,255,255,.9);
      color: #1f2a37;
      font-size: 12px;
      font-weight: 800;
    }
    .preview-answer {
      display: grid;
      gap: 8px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }
    .confirm-panel {
      display: grid;
      gap: 12px;
    }
    .confirm-warning {
      padding: 14px;
      border: 1px solid #fed7aa;
      border-radius: 8px;
      background: #fff7ed;
      color: #9a3412;
      line-height: 1.6;
    }

    .score-card {
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }
    .score-card strong { display: block; margin-bottom: 7px; }
    .score-card p { margin: 0 0 10px; color: var(--muted); font-size: 12px; line-height: 1.55; }

    .bars { display: grid; gap: 10px; }
    .bar-row {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr) 42px;
      align-items: center;
      gap: 9px;
      font-size: 12px;
      color: #435066;
    }

    .mini-chart {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      align-items: end;
      gap: 8px;
      height: 132px;
      padding: 10px 8px 0;
      border-bottom: 1px solid var(--line);
    }
    .mini-chart span {
      display: block;
      border-radius: 6px 6px 0 0;
      background: linear-gradient(180deg, #1e88e5, #00a896);
      min-height: 20px;
    }
    .chart-labels {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
      padding-top: 8px;
      color: var(--muted);
      font-size: 11px;
      text-align: center;
    }

    .drawer-mask {
      position: fixed;
      inset: 0;
      background: rgba(16, 32, 51, .42);
      display: none;
      z-index: 20;
    }
    .drawer-mask.open { display: block; }

    .drawer {
      position: fixed;
      top: 50%;
      left: 50%;
      right: auto;
      width: min(960px, calc(100vw - 32px));
      height: auto;
      max-height: min(86vh, 760px);
      border-radius: 10px;
      background: #fff;
      box-shadow: 0 24px 60px rgba(31,42,55,.24);
      transform: translate(-50%, -46%) scale(.96);
      opacity: 0;
      pointer-events: none;
      transition: transform .18s ease, opacity .18s ease;
      z-index: 21;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      overflow: hidden;
    }
    .drawer.open {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
      pointer-events: auto;
    }
    .drawer.modal-center {
      top: 50%;
      left: 50%;
      right: auto;
      width: min(960px, calc(100vw - 32px));
      height: auto;
      max-height: min(86vh, 760px);
      border-radius: 10px;
      box-shadow: 0 24px 60px rgba(31,42,55,.24);
      transform: translate(-50%, -46%) scale(.96);
      opacity: 0;
      pointer-events: none;
      transition: transform .18s ease, opacity .18s ease;
      grid-template-rows: auto minmax(0, 1fr) auto;
      overflow: hidden;
    }
    .drawer.modal-center.open {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
      pointer-events: auto;
    }
    .drawer-head, .drawer-foot {
      padding: 18px;
      border-bottom: 1px solid var(--line);
    }
    .drawer-foot {
      border-top: 1px solid var(--line);
      border-bottom: 0;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }
    .drawer-head h2 { margin: 0 0 6px; font-size: 20px; }
    .drawer-head p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
    .drawer-body { padding: 18px; overflow: auto; }
    .drawer .drawer-body { max-height: calc(86vh - 150px); }
    .drawer.modal-center .drawer-body { max-height: calc(86vh - 150px); }

    .toast {
      position: fixed;
      right: 24px;
      bottom: 24px;
      min-width: 260px;
      max-width: 420px;
      padding: 12px 14px;
      border-radius: 8px;
      background: #102033;
      color: #fff;
      box-shadow: 0 12px 28px rgba(31,42,55,.2);
      display: none;
      z-index: 30;
      font-size: 13px;
      line-height: 1.5;
    }
    .toast.show { display: block; }

    @media (max-width: 1180px) {
      .grid.kpi { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid.two, .grid.three { grid-template-columns: 1fr; }
      .logic-flow { grid-template-columns: repeat(3, minmax(160px, 1fr)); }
    }

    @media (max-width: 820px) {
      .admin-shell { grid-template-columns: 1fr; }
      .sidebar {
        position: relative;
        height: auto;
        max-height: none;
      }
      .main { padding: 18px 14px 34px; }
      .topbar { display: grid; }
      .top-actions { justify-content: flex-start; }
      .grid.kpi { grid-template-columns: 1fr; }
      .split-form { grid-template-columns: 1fr; }
      .exam-question-card .question-grid { grid-template-columns: 1fr; }
      .image-upload-grid { grid-template-columns: 1fr; }
      .answer-option { grid-template-columns: 1fr; }
      .preview-cover { grid-template-columns: 1fr; }
      .logic-flow { grid-template-columns: 1fr; }
      h1 { font-size: 22px; }
    }
  </style>
</head>
