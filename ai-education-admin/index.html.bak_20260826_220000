    function getExamQuestionContext(card) {
      var typeSelect = card.querySelector('[data-question-type]');
      var scoreInput = card.querySelector('[data-question-score]');
      var difficultySelect = card.querySelector('[data-question-difficulty]');
      var knowledgeSelect = card.querySelector('[data-question-knowledge]');
      var examName = document.querySelector('#drawerBody [data-exam-name]');
      var knowledge = [];
      if (knowledgeSelect) {
        Array.prototype.forEach.call(knowledgeSelect.options, function(option) {
          if (option.selected) knowledge.push(option.textContent);
        });
      }
      return {
        examName: examName ? examName.value.trim() : '',
        type: typeSelect ? typeSelect.value : '单选题',
        score: scoreInput ? scoreInput.value : '10',
        difficulty: difficultySelect ? difficultySelect.value : '基础',
        knowledge: knowledge
      };
    }

    function autoGenerateExamQuestion(button) {
      var card = button.closest('[data-exam-question-card]');
      if (!card) return;
      var ctx = getExamQuestionContext(card);
      if (!ctx.knowledge.length) {
        showToast('请先为本题选择关联知识点。');
        return;
      }
      button.disabled = true;
      var oldText = button.textContent;
      button.textContent = '生成中...';
      window.setTimeout(function() {
        var type = ctx.type;
        var stemEl = card.querySelector('[data-question-stem]');
        var optionsEl = card.querySelector('[data-question-options]');
        var answerEl = card.querySelector('[data-question-answer]');
        var choiceField = card.querySelector('.exam-question-choice');
        var choiceLabel = card.querySelector('[data-question-choice-label]');
        var answerLabel = card.querySelector('[data-question-answer-label]');
        if (stemEl) {
          stemEl.value = ctx.examName
            ? '结合"' + ctx.examName + '"中的' + ctx.knowledge[0] + '，选择最符合题意的答案。'
            : '根据所选知识点，选择最符合题意的答案。';
        }
        if (type === '单选题') {
          if (choiceField) choiceField.style.display = '';
          if (choiceLabel) choiceLabel.textContent = '单选题选项';
          if (optionsEl) optionsEl.value = 'A. 相关错误认知\nB. 正确诊断或处理\nC. 常见干扰项\nD. 近似但不正确的结论';
          if (answerLabel) answerLabel.textContent = '正确答案与解析';
          if (answerEl) answerEl.value = '正确答案：B。AI已按所选知识点自动生成题干、选项和解析，请继续人工微调。';
        } else if (type === '多选题') {
          if (choiceField) choiceField.style.display = '';
          if (choiceLabel) choiceLabel.textContent = '多选题选项';
          if (optionsEl) optionsEl.value = 'A. 关键表现之一\nB. 关键表现之二\nC. 非典型表现\nD. 需要排除的干扰项';
          if (answerLabel) answerLabel.textContent = '正确答案与解析';
          if (answerEl) answerEl.value = '正确答案：A、B。请人工检查多选项是否与知识点一致。';
        } else if (type === '简答题') {
          if (choiceField) choiceField.style.display = 'none';
          if (answerLabel) answerLabel.textContent = '参考答案、评分点与解析';
          if (answerEl) answerEl.value = '评分点：1. 描述核心概念；2. 说明临床意义；3. 结合所选知识点给出简明结论。';
        } else if (type === '病例分析题') {
          if (choiceField) choiceField.style.display = 'none';
          if (answerLabel) answerLabel.textContent = '参考答案、评分点与解析';
          if (answerEl) answerEl.value = '标准答案：结合病例资料、关键影像和知识点完成诊断。评分点包括病因判断、鉴别诊断和处理建议。';
        } else if (type === '代码题') {
          if (choiceField) choiceField.style.display = 'none';
          if (answerLabel) answerLabel.textContent = '参考代码与判分说明';
          if (answerEl) answerEl.value = '参考代码：根据输入数据完成核心指标计算。判分说明：按功能正确性、边界处理和输出格式评分。';
        }
        if (card.querySelector('[data-question-difficulty]') && ctx.difficulty) {
          card.querySelector('[data-question-difficulty]').value = ctx.difficulty;
        }
        if (card.querySelector('[data-question-score]') && ctx.score) {
          card.querySelector('[data-question-score]').value = ctx.score;
        }
        syncExamQuestionCard(card);
        updateExamQuestionSummary();
        button.disabled = false;
        button.textContent = oldText;
        showToast('已根据所选知识点自动填充本题。');
      }, 650);
    }

