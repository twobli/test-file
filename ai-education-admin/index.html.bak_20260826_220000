        var chapterRecords = recordsByCourse[courseId];
        if (!chapterRecords || typeof chapterRecords !== 'object') return;

        Object.keys(chapterRecords).forEach(function(chapterId) {
          var record = chapterRecords[chapterId];
          if (!record) return;
          var latestAttempt = Array.isArray(record.history) && record.history.length
            ? record.history[record.history.length - 1]
            : record;
          var student = getOrCreateStudent(
            record.studentName || (latestAttempt && latestAttempt.studentName),
            record.studentGroup || (latestAttempt && latestAttempt.studentGroup)
          );
          var chapterTitle = record.chapterTitle || ('章节 ' + chapterId);
          var syncedAttempts = getFrontEndRecordAttempts(record).map(function(attempt) {
            attempt.chapterTitle = chapterTitle;
            return attempt;
          });
          if (!syncedAttempts.length) return;
          var course = student.courses.find(function(item) { return item.name === courseName; });
          if (!course) {
            course = { name: courseName, progress: 0, quizAttempts: [], state: '已完成章节测验，可继续学习或重复测验' };
            student.courses.push(course);
          }
          course._fromFrontendQuiz = true;
          course.progress = Math.max(Number(course.progress) || 0, Number(record.learningProgress) || 0);
          course.quizChapter = course.quizChapter
            ? course.quizChapter + '、' + chapterTitle
            : chapterTitle;
          course.quizAttempts = (course.quizAttempts || []).concat(syncedAttempts);
          course.quizAttempts.sort(function(a, b) { return (a.completedAt || 0) - (b.completedAt || 0); });
          course.state = '已完成章节测验，可继续学习或重复测验';
        });
      });
    }

