      return labels[attemptNo - 1] || '第' + attemptNo + '次测验';
    }

    function formatFrontEndAnswer(options, value) {
      if (value === undefined || value === null || value === -1) return '未作答';
      if (Array.isArray(options) && options[value] !== undefined) return options[value];
      return String(value);
    }

    function normalizeFrontEndQuestions(questionItems) {
      if (!Array.isArray(questionItems)) return [];
      return questionItems.map(function(question, index) {
        var correct = question.correct;
        var userAnswer = question.userAnswer;
        var isCorrect = question.status === 'correct' || (correct !== undefined && userAnswer === correct);
        return {
          no: question.questionNo || question.no || index + 1,
          title: question.q || question.title || '未命名题目',
          result: isCorrect ? '答对' : '答错',
          userAnswer: formatFrontEndAnswer(question.opts || question.options, userAnswer),
          correctAnswer: formatFrontEndAnswer(question.opts || question.options, correct),
          knowledge: question.keyword || question.knowledge || '未绑定知识点',
          analysis: question.explain || question.analysis || '暂无解析'
        };
      });
    }

    function getFrontEndRecordAttempts(record) {
      if (!record) return [];
      var history = Array.isArray(record.history) ? record.history : [];
      if (!history.length && record.completedAt) {
        history = [{
          attempt: record.attempts || 1,
          accuracy: record.latestAccuracy || 0,
          correct: record.latestCorrect || 0,
          wrong: record.latestWrong || 0,
          total: record.total || 0,
          answers: record.answers || {},
          questionItems: record.questionItems || [],
          completedAt: record.completedAt
        }];
      }
      return history.map(function(attempt, index) {
        return {
          label: getFrontEndAttemptLabel(attempt.attempt || index + 1),
          score: Number(attempt.accuracy) || 0,
          date: formatFrontEndDate(attempt.completedAt),
          questions: normalizeFrontEndQuestions(attempt.questionItems || attempt.questions),
          completedAt: attempt.completedAt || 0
        };
      });
    }

