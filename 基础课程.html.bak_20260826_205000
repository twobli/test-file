.attempt-filter { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 14px; padding: 10px 12px; border-radius: 10px; background: var(--gray-50); border: 1px solid var(--gray-200); }
.attempt-filter label { color: var(--gray-700); font-size: 12px; font-weight: 700; }
.attempt-filter select { min-width: 250px; height: 34px; border: 1px solid var(--gray-200); border-radius: 8px; background: #fff; color: var(--gray-800); padding: 0 10px; font-family: inherit; }
.attempt-filter .attempt-filter-summary { color: var(--gray-500); font-size: 12px; }
.result-stat-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 20px; }
.result-stat-cards .rsc { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px 20px; text-align: center; }
.result-stat-cards .rsc .rsc-num { font-size: 28px; font-weight: 700; }
.result-stat-cards .rsc .rsc-num.correct-color { color: var(--success); }
.result-stat-cards .rsc .rsc-num.wrong-color { color: var(--danger); }
.result-stat-cards .rsc .rsc-num.total-color { color: var(--primary); }
.result-stat-cards .rsc .rsc-label { font-size: 12px; color: var(--gray-600); margin-top: 2px; }
.knowledge-mastery { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px 22px; margin-bottom: 20px; }
