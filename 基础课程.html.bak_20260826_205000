    function getHomeAIResponse(msg) {
        let msgLower = msg.toLowerCase();
        let bestMatch = null;
        for (let key in AI_KNOWLEDGE_BASE) {
            let entry = AI_KNOWLEDGE_BASE[key];
            for (let kw of entry.keywords) {
                if (msgLower.includes(kw.toLowerCase()) || msg.includes(kw)) {
                    bestMatch = entry;
                    break;
                }
            }
            if (bestMatch) break;
        }

        if (bestMatch) return '【医学课程问答】\n\n' + bestMatch.default;

        const genericResponses = [
            '当前问答基于基础课程内的医学学习内容。这个问题建议先明确对应的疾病、检查、分级或治疗主题，再结合课程中的眼底照相、OCT/FFA和临床分级知识理解。',
            '这个问题可以作为医学课程问答处理。建议把问题拆成“疾病是什么、关键表现是什么、检查如何判断、临床处理怎么做”四步，这样更容易和课程内容对应起来。',
            '如果问题和医学课程无关，系统不会展开回答。若你想问课程内容，可以补充疾病名称、检查项目或分级标准，例如DR分级、KWB分级、OCT判读等。'
        ];
        let idx = 0;
        for (let i = 0; i < msg.length; i++) idx = (idx * 31 + msg.charCodeAt(i)) % genericResponses.length;
        return genericResponses[idx];
    }

    function getSectionAIResponse(msg) {
        const ctx = getCurrentLearningContext();
        if (!ctx || !ctx.section) return getHomeAIResponse(msg);
        const points = getSectionKnowledgePoints(ctx.section.id);
        const matchedPoint = points.find(point => msg.includes(point) || point.toLowerCase().includes(msg.toLowerCase()) || msg.toLowerCase().includes(point.toLowerCase()));
        const targetPoint = aiQaMode === 'difficulty'
            ? ((aiActiveKnowledgePoint && points.includes(aiActiveKnowledgePoint)) ? aiActiveKnowledgePoint : points[0])
            : (matchedPoint || points[0]);
        const prefix = aiQaMode === 'difficulty'
            ? '【课程难点讲解｜' + getKnowledgePointScopeLabel() + '】\n\n'
            : '【自然语言问答｜' + getAIContextLabel() + '】\n\n';
        if (targetPoint) {
            if (aiQaMode === 'difficulty') {
                return prefix + getKnowledgePointExplanation(targetPoint, ctx) + '\n\n后续问答会继续围绕“' + targetPoint + '”展开。你可以追问它的临床意义、易错考法、和其他通路/概念的区别。';
            }
            return prefix + getKnowledgePointExplanation(targetPoint, ctx) + '\n\n这个回答已限定在当前课程小节内，不会扩展到新的对话主题。';
        }
        return prefix + '当前问题会优先结合本小节内容回答。' + (getSectionIntro(ctx.section) || '建议先围绕本节标题提出具体问题。') + '\n\n你也可以直接围绕房水生成、排出通路或眼压升高原因继续追问。';
    }

    function getAIResponse(msg) {
        if (aiQaContextType === 'section') return getSectionAIResponse(msg);
        return getHomeAIResponse(msg);
