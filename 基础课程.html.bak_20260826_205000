// ==================== 测验结果页 ====================
function formatQuizDate(timestamp) {
    if (!timestamp) return '--';
    const date = new Date(timestamp);
    const pad = value => String(value).padStart(2, '0');
    return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate())
        + ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes());
}

function getQuizDisplayTitle(title) {
    const text = (title || '').trim();
    return text.replace(/^第[一二三四五六七八九十百\d]+章\s*/, '') || '章节';
}

function getSelectedAttemptIndex(history, selectedAttempt) {
    if (!history.length) return -1;
    if (!selectedAttempt) return history.length - 1;
    const sameObjectIndex = history.findIndex(item => item === selectedAttempt);
    if (sameObjectIndex >= 0) return sameObjectIndex;
    const sameTimeIndex = history.findIndex(item => item.completedAt && item.completedAt === selectedAttempt.completedAt);
    return sameTimeIndex >= 0 ? sameTimeIndex : history.length - 1;
}

function renderQuizHistory(course, chapterIndex, record, selectedAttempt) {
    const selectEl = document.getElementById('quizAttemptSelect');
    const summaryEl = document.getElementById('quizAttemptSummary');
    if (!selectEl || !summaryEl) return;

    const history = getQuizHistory(record);
    if (!history.length) {
        selectEl.innerHTML = '<option value="">暂无测验记录</option>';
        selectEl.disabled = true;
        summaryEl.textContent = '当前章节还没有历史测验记录';
        return;
    }

    const selectedIndex = getSelectedAttemptIndex(history, selectedAttempt);
    const selectedDisplayIndex = selectedIndex >= 0 ? selectedIndex + 1 : history.length;
    selectEl.disabled = false;
    selectEl.innerHTML = history.slice().reverse().map((item, reverseIndex) => {
        const attemptIndex = history.length - reverseIndex - 1;
        const displayAttempt = attemptIndex + 1;
        const isLatest = attemptIndex === history.length - 1;
        const title = isLatest ? '本次测验（第 ' + displayAttempt + ' 次）' : '第 ' + displayAttempt + ' 次';
        return '<option value="' + attemptIndex + '">' + title + '｜' + (item.accuracy || 0) + '%｜' + formatQuizDate(item.completedAt) + '</option>';
    }).join('');
    selectEl.value = String(selectedIndex);
    summaryEl.textContent = selectedIndex === history.length - 1
        ? '当前显示本次测验结果，共 ' + history.length + ' 次记录'
        : '当前回看第 ' + selectedDisplayIndex + ' 次测验结果，共 ' + history.length + ' 次记录';
}

function selectQuizAttempt(value) {
    if (value === '') return;
    const attemptIndex = Number(value);
    if (!Number.isInteger(attemptIndex)) return;
    viewQuizAttempt(currentQuizCourseId, currentQuizChapterIndex, attemptIndex);
}

function showResultPage(courseName, quizData, elapsedSeconds, storedRecord, selectedAttempt) {
    showPage('page-quiz-result');
    document.getElementById('resultBreadcrumbCourse').textContent = courseName;

    const result = calculateQuizResult(quizData, quizAnswers);
    const total = result.total;
    const correct = result.correct;
    const wrong = result.wrong;
    const wrongItems = result.wrongItems;
    const questionItems = result.questionItems;
    const pct = result.accuracy;
    const course = getCourseById(currentCourseId);
    const resultChapter = course && course.chapters ? course.chapters[currentQuizChapterIndex] : null;
    const learningProgress = storedRecord ? storedRecord.learningProgress : getChapterLearningProgress(course, currentQuizChapterIndex);
    const history = getQuizHistory(storedRecord);
    const attempts = history.length || (storedRecord ? storedRecord.attempts : 1);
    const selectedAttemptIndex = getSelectedAttemptIndex(history, selectedAttempt);
    const selectedAttemptNo = selectedAttemptIndex >= 0 ? selectedAttemptIndex + 1 : attempts;
    const attemptLabel = selectedAttemptIndex === history.length - 1
        ? '本次：第' + selectedAttemptNo + '次 / 共' + attempts + '次'
        : '当前查看：第' + selectedAttemptNo + '次 / 共' + attempts + '次';
    currentResultContext = {
        feedbackKey: getFeedbackKey(course, resultChapter, selectedAttemptNo),
        attemptNo: selectedAttemptNo,
        attempts,
        learningProgress,
        accuracy: pct,
        questionItems
    };
    document.getElementById('resultTitle').textContent = (resultChapter ? getQuizDisplayTitle(resultChapter.title) + ' - ' : '') + '测验结果';

    document.getElementById('resultScore').textContent = pct + '%';
    document.getElementById('resultPct').textContent = pct + '%';
    document.getElementById('rCorrect').textContent = correct;
    document.getElementById('rWrong').textContent = wrong;
    document.getElementById('rTotal').textContent = total;
    document.getElementById('resultLearningProgress').textContent = '本章学习进度：' + learningProgress + '%';
    document.getElementById('resultAttempts').textContent = attemptLabel;
    renderKnowledgeMastery(result.mastery);
    renderQuizHistory(course, currentQuizChapterIndex, storedRecord, selectedAttempt);
    renderCourseFeedbackContext(course, resultChapter);

    // 环形图
    let circumference = 389.6;
    let offset = circumference - (pct / 100 * circumference);
    document.getElementById('resultRing').setAttribute('stroke-dashoffset', offset);

    // 知识追踪与学习路径优化
    document.getElementById('reinforceAlert').style.display = 'block';
    document.getElementById('reinforceItems').innerHTML = buildLearningPathHtml(wrongItems, pct);

    renderQuestionReview(questionItems);
}

function getQuestionStatusLabel(status) {
    if (status === 'correct') return '答对';
    return '答错';
}

function escapeResultHtml(text) {
    return String(text == null ? '' : text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function formatAnswerText(question, answerIndex) {
    if (answerIndex === -1 || answerIndex === undefined || answerIndex === null) return '未作答';
    return String.fromCharCode(65 + answerIndex) + '. ' + question.opts[answerIndex];
}

function renderQuestionReview(items, filter, activeQuestionNo) {
    const target = document.getElementById('questionReview');
    if (!target) return;
    const questions = items || [];
    const currentFilter = filter || 'all';
    const filtered = currentFilter === 'all' ? questions : questions.filter(item => item.status === currentFilter);
    const defaultQuestion = questions.find(item => item.status !== 'correct') || questions[0];
    const activeNo = activeQuestionNo
        || (currentFilter === 'all' && defaultQuestion ? defaultQuestion.questionNo : null)
        || (filtered[0] ? filtered[0].questionNo : null);
    const active = activeNo ? (questions.find(item => item.questionNo === activeNo) || null) : null;
    const counts = {
        correct: questions.filter(item => item.status === 'correct').length,
        wrong: questions.filter(item => item.status === 'wrong').length
    };
    const filterItems = [
        { key: 'all', text: '全部 ' + questions.length },
        { key: 'wrong', text: '答错 ' + counts.wrong },
        { key: 'correct', text: '答对 ' + counts.correct }
    ];
    target.dataset.filter = currentFilter;
    target.innerHTML = `
        <div class="qr-head">
            <div>
                <div class="qr-title">答题明细与解析</div>
                <div class="qr-subtitle">提交前必须完成全部题目；提交后通过题号快速查看每道题对错，再点击题号查看完整解析。正确题也保留解析，便于复盘干扰选项和相关知识点。</div>
            </div>
            <div class="qr-summary">答对 ${counts.correct} 题 · 答错 ${counts.wrong} 题</div>
        </div>
        <div class="qr-filters">
            ${filterItems.map(item => `<button class="qr-filter ${item.key === currentFilter ? 'active' : ''}" type="button" onclick="filterQuestionReview('${item.key}')">${item.text}</button>`).join('')}
        </div>
        <div class="qr-layout">
            <div>
                <div class="qr-number-grid">
                    ${filtered.length ? filtered.map(item => `<button class="qr-number ${item.status} ${active && item.questionNo === active.questionNo ? 'active' : ''}" type="button" onclick="selectQuestionReview(${item.questionNo})">${item.questionNo}</button>`).join('') : '<div class="qr-empty">当前筛选下暂无题目</div>'}
                </div>
                <div class="qr-legend">
                    <span><i class="qr-dot correct"></i>答对</span>
                    <span><i class="qr-dot wrong"></i>答错</span>
                </div>
            </div>
            <div class="qr-detail" id="questionReviewDetail">${active ? buildQuestionReviewDetail(active) : '<div class="qr-empty">请选择题号查看解析</div>'}</div>
        </div>
    `;
}

function filterQuestionReview(filter) {
    if (!currentResultContext || !currentResultContext.questionItems) return;
    renderQuestionReview(currentResultContext.questionItems, filter);
}

function selectQuestionReview(questionNo) {
    if (!currentResultContext || !currentResultContext.questionItems) return;
    const filter = document.getElementById('questionReview') ? document.getElementById('questionReview').dataset.filter : 'all';
    renderQuestionReview(currentResultContext.questionItems, filter || 'all', questionNo);
}

function buildQuestionReviewDetail(question) {
    const userAnswerText = formatAnswerText(question, question.userAnswer);
    const correctAnswerText = formatAnswerText(question, question.correct);
    const optionsHtml = question.opts.map((option, index) => {
        const isCorrect = index === question.correct;
        const isUserWrong = question.userAnswer === index && !isCorrect;
        const classes = ['qr-option'];
        if (isCorrect) classes.push('correct-answer');
        if (isUserWrong) classes.push('user-wrong');
        const suffix = isCorrect ? '正确答案' : (isUserWrong ? '你的选择' : '');
        return `<div class="${classes.join(' ')}">
            <span class="qr-option-tag">${String.fromCharCode(65 + index)}</span>
            <span>${escapeResultHtml(option)}${suffix ? ' · ' + suffix : ''}</span>
        </div>`;
    }).join('');
    return `
        <div class="qr-detail-head">
            <div class="qr-detail-title">第${question.questionNo}题</div>
            <span class="qr-status ${question.status}">${getQuestionStatusLabel(question.status)}</span>
        </div>
        <div class="qr-question">${escapeResultHtml(question.q)}</div>
        <div class="qr-options">${optionsHtml}</div>
        <div class="qr-explanation">
            <strong>你的答案：</strong>${escapeResultHtml(userAnswerText)}<br>
            <strong>正确答案：</strong>${escapeResultHtml(correctAnswerText)}<br>
            <strong>解析：</strong>${escapeResultHtml(question.explain)}
        </div>
    `;
}

function renderCourseFeedbackContext(course, chapter) {
    const contextEl = document.getElementById('courseFeedbackContext');
    const tipEl = document.getElementById('courseFeedbackTip');
    if (!contextEl) return;
    const courseName = course ? course.name : '基础课程';
    const chapterName = chapter ? getQuizDisplayTitle(chapter.title) : '当前章节';
    const contextParts = [courseName, chapterName];
    if (currentResultContext && currentResultContext.attemptNo) {
        contextParts.push('第' + currentResultContext.attemptNo + '次测验');
    }
    contextEl.textContent = contextParts.join('｜');
    renderCourseFeedbackState();
}

function readCourseFeedbackList() {
    try {
        const stored = JSON.parse(localStorage.getItem(COURSE_FEEDBACK_STORAGE_KEY) || '[]');
        return Array.isArray(stored) ? stored : [];
    } catch (e) {
        return [];
    }
}

function getFeedbackKey(course, chapter, attemptNo) {
    const courseId = course ? course.id : (currentQuizCourseId || currentCourseId || 'course');
    const chapterId = chapter ? chapter.id : ('chapter_' + (Number.isInteger(currentQuizChapterIndex) ? currentQuizChapterIndex : 0));
    return [courseId, chapterId, attemptNo || 1].join('_');
}

function getCurrentAttemptFeedback() {
    const context = currentResultContext || {};
    if (!context.feedbackKey) return null;
    return readCourseFeedbackList().find(item => item.feedbackKey === context.feedbackKey) || null;
}

function setCourseFeedbackDisabled(disabled) {
    const typeEl = document.getElementById('courseFeedbackType');
    const contentEl = document.getElementById('courseFeedbackContent');
    const submitBtn = document.getElementById('courseFeedbackSubmitBtn');
    if (typeEl) typeEl.disabled = disabled;
    if (contentEl) contentEl.disabled = disabled;
    if (submitBtn) {
        submitBtn.disabled = disabled;
        submitBtn.textContent = disabled ? '本次已反馈' : '提交反馈';
    }
}

function renderCourseFeedbackState() {
    const tipEl = document.getElementById('courseFeedbackTip');
    const recordEl = document.getElementById('courseFeedbackRecord');
    const contentEl = document.getElementById('courseFeedbackContent');
    const existing = getCurrentAttemptFeedback();
    if (existing) {
        setCourseFeedbackDisabled(true);
        if (contentEl) contentEl.value = '';
        if (recordEl) {
            recordEl.classList.add('show');
            recordEl.innerHTML = `
                <div class="cf-record-head">
                    <div class="cf-record-title">本次测验反馈记录</div>
                    <div class="cf-record-time">${escapeResultHtml(existing.time)}</div>
                </div>
                <div class="cf-record-content">${escapeResultHtml(existing.content)}</div>
                <div class="cf-record-meta">反馈类型：${escapeResultHtml(existing.type)} · 状态：${escapeResultHtml(existing.status)}</div>
            `;
        }
        if (tipEl) tipEl.textContent = '本次测验已提交反馈，不能重复提交；重新测验后可对新的测验结果再次反馈。';
    } else {
        setCourseFeedbackDisabled(false);
        if (recordEl) {
            recordEl.classList.remove('show');
            recordEl.innerHTML = '';
        }
        if (tipEl) tipEl.textContent = '每次测验仅可提交一次反馈；提交后会在本页形成记录，并进入教师课程管理端。';
    }
}

function getCurrentStudentName() {
    try {
        const user = JSON.parse(localStorage.getItem('life_med_user') || '{}');
        return user.name || user.username || user.realName || '当前学生';
    } catch (e) {
        return '当前学生';
    }
}

function submitCourseFeedback() {
    const typeEl = document.getElementById('courseFeedbackType');
    const contentEl = document.getElementById('courseFeedbackContent');
    const tipEl = document.getElementById('courseFeedbackTip');
    if (!contentEl) return;
    if (getCurrentAttemptFeedback()) {
        renderCourseFeedbackState();
        return;
    }

    const content = contentEl.value.trim();
    if (!content) {
        if (tipEl) tipEl.textContent = '请先填写反馈内容。';
        contentEl.focus();
        return;
    }

    const course = getCourseById(currentQuizCourseId || currentCourseId);
    const chapterIndex = Number.isInteger(currentQuizChapterIndex)
        ? currentQuizChapterIndex
        : (Number.isInteger(currentChapterIndex) ? currentChapterIndex : 0);
    const chapter = course && course.chapters ? course.chapters[chapterIndex] : null;
    const context = currentResultContext || {};
    const feedback = {
        feedbackKey: context.feedbackKey || getFeedbackKey(course, chapter, context.attemptNo || 1),
        time: formatQuizDate(Date.now()),
        student: getCurrentStudentName(),
        course: course ? course.name : '基础课程',
        chapter: chapter ? getQuizDisplayTitle(chapter.title) : '当前章节',
        chapterId: chapter ? chapter.id : '',
        attemptNo: context.attemptNo || 1,
        attempts: context.attempts || 1,
        learningProgress: context.learningProgress,
        accuracy: context.accuracy,
        type: typeEl ? typeEl.value : '课程内容',
        content,
        status: '待处理'
    };

    const list = readCourseFeedbackList();
    list.unshift(feedback);
    try {
        localStorage.setItem(COURSE_FEEDBACK_STORAGE_KEY, JSON.stringify(list));
    } catch (e) {}

    contentEl.value = '';
    renderCourseFeedbackState();
}

