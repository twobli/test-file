function resolveCourseResource(ref) {
    const course = getCourseById(ref.courseId);
    if (!course || !course.chapters) return null;
    const chapterIndex = Number.isInteger(ref.chapterIndex) ? ref.chapterIndex : course.chapters.findIndex(ch => ch.id === ref.chapterId);
    const chapter = course.chapters[chapterIndex];
    if (!chapter || !chapter.sections) return null;
    const sectionIndex = Number.isInteger(ref.sectionIndex) ? ref.sectionIndex : chapter.sections.findIndex(sec => sec.id === ref.sectionId);
    const section = chapter.sections[sectionIndex];
    if (!section) return null;
    return { course, chapter, section, chapterIndex, sectionIndex, reason: ref.reason || '' };
}

function buildInternalCourseRecommendations(keyword) {
    const config = getRecommendationConfig(keyword);
    const cards = (config.courses || []).map(resolveCourseResource).filter(Boolean).map(item => {
        const learned = isSectionComplete(item.course, item.chapterIndex, item.sectionIndex);
        const statusText = learned ? '已学习' : '未学习';
        const statusClass = learned ? 'learned' : 'unlearned';
        return `<div class="ra-course-card">
            <div class="ra-course-head">
                <div class="ra-course-name">${item.course.name}｜${item.section.title}</div>
                <span class="ra-status ${statusClass}">${statusText}</span>
            </div>
            <div class="ra-course-meta">${getQuizDisplayTitle(item.chapter.title)} · ${item.section.duration}</div>
            <div class="ra-course-reason">${item.reason}</div>
            <button class="ra-link-btn" type="button" onclick="openRecommendedSection(${item.course.id}, ${item.chapterIndex}, ${item.sectionIndex})">进入课程内容</button>
        </div>`;
    }).join('');
    return `<div class="ra-course-list">${cards || '<div class="ra-course-card">当前知识点暂未绑定基础课程内容，请先在后台知识点库完成课程小节绑定。</div>'}</div>`;
}

function openRecommendedSection(courseId, chapterIndex, sectionIndex) {
    const course = getCourseById(courseId);
    const chapter = course && course.chapters ? course.chapters[chapterIndex] : null;
    const section = chapter && chapter.sections ? chapter.sections[sectionIndex] : null;
    if (!course || !chapter || !section) return;
    clearVideoInterval();
    currentCourseId = courseId;
    currentChapterIndex = chapterIndex;
    currentSectionIndex = sectionIndex;
    currentSectionId = section.id;
    showPage('page-video-learning');
