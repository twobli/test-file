function buildLearningPathHtml(wrongItems, accuracy) {
    if (wrongItems.length === 0) {
        return `<div class="ra-empty">本次测验正确率 ${accuracy}%，当前知识掌握较稳定。建议继续学习本课程后续章节；若需要扩展，可结合教材或指南复盘本章核心概念。</div>`;
    }

    const weakMap = new Map();
    wrongItems.forEach(w => {
        const keyword = extractKeyword(w.q, w.explain);
        if (!weakMap.has(keyword)) {
            weakMap.set(keyword, { keyword, count: 0, questions: [] });
        }
        const item = weakMap.get(keyword);
        item.count++;
        item.questions.push(w.questionNo);
    });

    const weakItems = Array.from(weakMap.values()).sort((a, b) => b.count - a.count);
    const cards = weakItems.map((item, index) => {
        const wrongQuestions = uniqueNumbers(item.questions);
        const relatedQuestions = getKnowledgeQuestionNumbers(item.keyword, currentQuizData);
        return `<div class="ra-item">
            <div class="ra-line">
                <span class="ra-badge">薄弱项${index + 1}</span>
                <span class="ra-name">${item.keyword}</span>
            </div>
            <div class="ra-track">知识追踪：此知识点关联本章节的${formatQuestionList(relatedQuestions)}；你在${formatQuestionList(wrongQuestions)}出错。</div>
            <div class="ra-recommend-grid">
                <div class="ra-section">
                    <div class="ra-section-title">推荐下一步学习内容：基础课程内课程内容</div>
                    ${buildInternalCourseRecommendations(item.keyword)}
                </div>
            </div>
        </div>`;
    }).join('');

    return `<div class="ra-list">${cards}</div>`;
}

function uniqueNumbers(numbers) {
    return Array.from(new Set((numbers || []).filter(n => Number.isFinite(n)))).sort((a, b) => a - b);
}

function formatQuestionList(numbers) {
    const list = uniqueNumbers(numbers);
    return list.length ? list.map(n => '第' + n + '题').join('、') : '暂无绑定题目';
}

function getKnowledgeQuestionNumbers(keyword, quizData) {
    const list = quizData || [];
    const numbers = [];
    list.forEach((q, index) => {
        if (extractKeyword(q.q, q.explain) === keyword) numbers.push(index + 1);
    });
    return numbers.length ? numbers : [];
}

function getRecommendationConfig(keyword) {
    if (KNOWLEDGE_POINT_RECOMMENDATIONS[keyword]) return KNOWLEDGE_POINT_RECOMMENDATIONS[keyword];
    const matchedKey = Object.keys(KNOWLEDGE_POINT_RECOMMENDATIONS).find(key => keyword.includes(key) || key.includes(keyword));
    return matchedKey ? KNOWLEDGE_POINT_RECOMMENDATIONS[matchedKey] : {
        courses: [{ courseId: currentQuizCourseId || currentCourseId, chapterIndex: currentQuizChapterIndex || 0, sectionIndex: 0, reason: '回到当前章节首节内容，重新梳理本题相关概念。' }],
