.reinforce-alert .ra-name { font-size: 14px; color: var(--gray-900); font-weight: 700; }
.reinforce-alert .ra-meta { color: var(--gray-500); font-size: 12px; margin-top: 4px; }
.reinforce-alert .ra-track { margin-top: 8px; color: var(--gray-700); font-size: 13px; line-height: 1.7; }
.reinforce-alert .ra-recommend-grid { display: grid; grid-template-columns: 1fr; gap: 12px; margin-top: 12px; }
.reinforce-alert .ra-section { border: 1px solid var(--gray-200); border-radius: 8px; background: #fbfcff; padding: 12px; }
