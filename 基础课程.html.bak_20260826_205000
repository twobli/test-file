.knowledge-mastery .km-summary { flex-shrink: 0; color: var(--primary); background: var(--primary-light); border-radius: 999px; padding: 5px 10px; font-size: 12px; font-weight: 600; }
.knowledge-mastery .km-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.knowledge-mastery .km-item { border: 1px solid var(--gray-200); border-radius: 8px; padding: 12px; background: var(--gray-50); }
.knowledge-mastery .km-item-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
