.course-feedback .cf-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
.course-feedback .cf-title { font-size: 15px; font-weight: 700; color: var(--gray-900); margin-bottom: 4px; }
.course-feedback .cf-subtitle { color: var(--gray-600); font-size: 12px; line-height: 1.6; }
.course-feedback .cf-context { flex-shrink: 0; max-width: 320px; color: var(--primary); background: var(--primary-light); border-radius: 999px; padding: 5px 10px; font-size: 12px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.course-feedback .cf-form { display: grid; grid-template-columns: 220px minmax(0, 1fr) 144px; gap: 12px; align-items: start; }
.course-feedback label { display: block; color: var(--gray-700); font-size: 12px; font-weight: 700; margin-bottom: 6px; }
.course-feedback select, .course-feedback textarea { width: 100%; border: 1px solid var(--gray-200); border-radius: 8px; background: #fff; color: var(--gray-800); font-family: inherit; font-size: 13px; outline: none; transition: var(--transition); }
.course-feedback select { height: 38px; padding: 0 10px; }
.course-feedback textarea { min-height: 72px; resize: vertical; padding: 10px 12px; line-height: 1.6; }
.course-feedback select:focus, .course-feedback textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(255,109,1,.12); }
.course-feedback select:disabled, .course-feedback textarea:disabled { background: var(--gray-50); color: var(--gray-500); cursor: not-allowed; }
.course-feedback .cf-submit-field { display: flex; flex-direction: column; }
.course-feedback .cf-submit-field label { visibility: hidden; }
.course-feedback .cf-submit-field .btn { width: 100%; height: 38px; }
.course-feedback .cf-submit-field .btn:disabled { background: var(--gray-300); color: var(--gray-500); cursor: not-allowed; }
.course-feedback .cf-tip { margin-top: 10px; color: var(--gray-500); font-size: 12px; }
.course-feedback .cf-record { margin-top: 12px; border: 1px solid #b7e1c1; background: #f0f8f2; border-radius: 10px; padding: 12px 14px; display: none; }
.course-feedback .cf-record.show { display: block; }
.course-feedback .cf-record-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
.course-feedback .cf-record-title { color: #137333; font-size: 13px; font-weight: 800; }
.course-feedback .cf-record-time { color: var(--gray-500); font-size: 12px; }
.course-feedback .cf-record-content { color: var(--gray-800); font-size: 13px; line-height: 1.7; }
.course-feedback .cf-record-meta { margin-top: 6px; color: var(--gray-600); font-size: 12px; }
@media (max-width: 900px) {
    .course-feedback .cf-head { flex-direction: column; }
    .course-feedback .cf-context { max-width: 100%; }
    .course-feedback .cf-form { grid-template-columns: 1fr; }
    .course-feedback .cf-submit-field label { display: none; }
}

/* ===== 答题明细与解析 ===== */
.question-review { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px 22px; margin-bottom: 20px; }
.question-review .qr-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
.question-review .qr-title { font-size: 16px; color: var(--gray-900); font-weight: 700; margin-bottom: 4px; }
.question-review .qr-subtitle { color: var(--gray-600); font-size: 12px; line-height: 1.6; }
.question-review .qr-summary { flex-shrink: 0; color: var(--primary); background: var(--primary-light); border-radius: 999px; padding: 5px 10px; font-size: 12px; font-weight: 600; }
.question-review .qr-filters { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
.question-review .qr-filter { height: 30px; padding: 0 12px; border: 1px solid var(--gray-200); border-radius: 999px; background: #fff; color: var(--gray-700); font-size: 12px; font-weight: 700; cursor: pointer; }
.question-review .qr-filter.active { border-color: var(--primary); color: var(--primary); background: var(--primary-light); }
.question-review .qr-layout { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 14px; align-items: start; }
.question-review .qr-number-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; padding: 12px; border: 1px solid var(--gray-200); border-radius: 10px; background: var(--gray-50); }
.question-review .qr-number { height: 34px; border: 1px solid var(--gray-200); border-radius: 8px; background: #fff; color: var(--gray-700); font-size: 13px; font-weight: 800; cursor: pointer; }
.question-review .qr-number.correct { border-color: #b7e1c1; color: #137333; background: #e6f4ea; }
.question-review .qr-number.wrong { border-color: #f5b5af; color: #c5221f; background: #fce8e6; }
.question-review .qr-number.active { box-shadow: 0 0 0 3px rgba(255,109,1,.15); border-color: var(--primary); }
.question-review .qr-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 10px; color: var(--gray-500); font-size: 12px; }
.question-review .qr-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-right: 4px; }
.question-review .qr-dot.correct { background: var(--success); }
.question-review .qr-dot.wrong { background: var(--danger); }
.question-review .qr-detail { border: 1px solid var(--gray-200); border-radius: 10px; padding: 16px; background: #fff; min-height: 220px; }
.question-review .qr-detail-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.question-review .qr-detail-title { color: var(--gray-900); font-weight: 800; font-size: 15px; }
.question-review .qr-status { border-radius: 999px; padding: 3px 9px; font-size: 12px; font-weight: 800; }
.question-review .qr-status.correct { color: #137333; background: #e6f4ea; }
.question-review .qr-status.wrong { color: #c5221f; background: #fce8e6; }
.question-review .qr-question { color: var(--gray-900); font-size: 14px; line-height: 1.7; margin-bottom: 12px; }
.question-review .qr-options { display: grid; gap: 8px; margin-bottom: 12px; }
.question-review .qr-option { display: flex; gap: 8px; align-items: flex-start; border: 1px solid var(--gray-200); border-radius: 8px; padding: 9px 11px; color: var(--gray-700); font-size: 13px; line-height: 1.5; background: var(--gray-50); }
.question-review .qr-option.correct-answer { border-color: #b7e1c1; background: #f0f8f2; color: #137333; }
.question-review .qr-option.user-wrong { border-color: #f5b5af; background: #fff5f4; color: #c5221f; }
.question-review .qr-option .qr-option-tag { flex-shrink: 0; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: #fff; border: 1px solid var(--gray-200); font-weight: 800; font-size: 12px; }
.question-review .qr-explanation { font-size: 13px; color: var(--gray-700); background: var(--gray-50); padding: 11px 13px; border-radius: 8px; line-height: 1.7; }
.question-review .qr-explanation strong { color: var(--gray-900); }
.question-review .qr-empty { padding: 18px; border: 1px dashed var(--gray-300); border-radius: 8px; color: var(--gray-500); text-align: center; font-size: 13px; }

/* ===== 弹窗 ===== */
.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 2000; display: flex; align-items: center; justify-content: center; }
.modal-dialog { background: #fff; border-radius: 12px; box-shadow: var(--shadow-lg); width: 90%; max-width: 460px; animation: slideUp 0.25s; }
.modal-dialog .modal-body { padding: 28px 28px 20px; text-align: center; }
.modal-dialog .modal-body .modal-icon { font-size: 48px; margin-bottom: 14px; }
.modal-dialog .modal-body h3 { font-size: 17px; color: var(--gray-900); margin-bottom: 8px; }
.modal-dialog .modal-body p { font-size: 13px; color: var(--gray-600); margin-bottom: 20px; }
.modal-dialog .modal-footer { padding: 14px 28px 20px; display: flex; justify-content: center; gap: 12px; }

/* ===== 动画 ===== */
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

/* ===== 响应式 ===== */
@media (max-width: 1200px) {
    .course-grid { grid-template-columns: repeat(3, 1fr); }
    .overview-grid { grid-template-columns: 1fr; }
    .result-stat-cards { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 900px) {
    .course-grid { grid-template-columns: repeat(2, 1fr); }
