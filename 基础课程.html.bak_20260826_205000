        return !!getSectionCompletionState(ctx.course, ctx.section.id).video;
    }

    window.openAiQaSystem = function() {
        if (currentPageId === 'page-video-learning') {
            const ctx = getCurrentLearningContext();
            if (!ctx || !ctx.section) {
                alert('请先进入具体课程小节后再使用课程内AI答疑。');
                return;
            }
            if (!canOpenSectionAiQa()) {
                alert('请先学完当前小节：视频播放到100%后，才能打开课程内AI智能答疑系统。');
                return;
            }
            aiQaContextType = 'section';
            aiQaMode = 'qa';
            aiReturnPageId = 'page-video-learning';
        } else {
            aiQaContextType = 'home';
            aiQaMode = 'qa';
            aiReturnPageId = 'page-course-list';
        }
        renderAiWelcome();
        showPage('page-ai-qa');
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
        const body = document.getElementById('aiChatBody');
        if (body) body.scrollTop = 0;
        const input = document.getElementById('aiChatInput');
        if (input) input.focus({ preventScroll: true });
    };

    window.startNewAiDialog = function() {
        resetCurrentAiDialog();
    };

    window.resetCurrentAiDialog = function() {
        const ctx = getCurrentLearningContext();
        if (aiQaContextType === 'section' && ctx && ctx.section) {
            if (aiQaMode === 'difficulty') {
                const points = getSectionKnowledgePoints(ctx.section.id);
                aiActiveKnowledgePoint = points[0] || '';
            }
        }
        renderAiWelcome();
        const input = document.getElementById('aiChatInput');
        if (input) {
            input.value = '';
            input.focus({ preventScroll: true });
        }
    };

    window.selectAiKnowledgePoint = function(point) {
        if (!point) return;
        aiQaContextType = 'section';
        aiQaMode = 'difficulty';
        aiActiveKnowledgePoint = point;
        renderAiWelcome();
        const input = document.getElementById('aiChatInput');
        if (input) input.focus({ preventScroll: true });
    };

    window.askQuickQuestion = function(q) {
        sendAiMessage(q);
    };

    window.switchAiMode = function(mode) {
        if (aiQaContextType !== 'section') return;
        aiQaMode = mode === 'difficulty' ? 'difficulty' : 'qa';
        renderAiWelcome();
    };

    window.returnFromAiQa = function() {
        if (aiReturnPageId === 'page-video-learning') {
            showPage('page-video-learning');
            renderChapterTree();
            renderVideoSection();
            return;
        }
        navToCourseList();
    };
});
</script>
</body>
</html>

