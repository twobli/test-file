function isCourseVideoComplete(course) {
    return !!course && course.progress >= 100;
}

function getSectionCompletionState(course, sectionId) {
    if (!course || !sectionId) return { video: false };
    if (isCourseVideoComplete(course)) return { video: true };
    const raw = completedSectionIdsByCourse[course.id] && completedSectionIdsByCourse[course.id][sectionId];
    if (raw === true) return { video: true };
    if (raw && typeof raw === 'object') return { video: !!raw.video };
    return { video: false };
}

function isSectionPartComplete(course, sectionId, part) {
    if (isCourseVideoComplete(course)) return true;
    return !!getSectionCompletionState(course, sectionId)[part];
}

function isSectionComplete(course, chapterIndex, sectionIndex) {
    if (!course || !course.chapters || !course.chapters[chapterIndex]) return false;
    if (isCourseVideoComplete(course)) return true;
    const section = course.chapters[chapterIndex].sections[sectionIndex];
    if (!section) return false;
    const state = getSectionCompletionState(course, section.id);
    return state.video;
}

function isChapterComplete(course, chapterIndex) {
    if (!course || !course.chapters || !course.chapters[chapterIndex]) return false;
    const sections = course.chapters[chapterIndex].sections || [];
    return sections.length > 0 && sections.every((section, sectionIndex) => isSectionComplete(course, chapterIndex, sectionIndex));
}

function persistCompletedSections() {
    try {
        localStorage.setItem(COMPLETION_STORAGE_KEY, JSON.stringify(completedSectionIdsByCourse));
    } catch (e) {}
}

function markSectionPartComplete(course, sectionId, part) {
    if (!course || !sectionId) return;
    if (!completedSectionIdsByCourse[course.id]) completedSectionIdsByCourse[course.id] = {};
    const current = getSectionCompletionState(course, sectionId);
    current[part] = true;
    completedSectionIdsByCourse[course.id][sectionId] = current;
    persistCompletedSections();
}

function markSectionComplete(course, sectionId) {
    if (!course || !sectionId) return;
    if (!completedSectionIdsByCourse[course.id]) completedSectionIdsByCourse[course.id] = {};
    completedSectionIdsByCourse[course.id][sectionId] = { video: true };
    persistCompletedSections();
}

function persistQuizRecords() {
    try {
        localStorage.setItem(QUIZ_STORAGE_KEY, JSON.stringify(quizRecordsByCourse));
    } catch (e) {}
}

function getChapterQuizRecord(courseId, chapterId) {
    const courseRecords = quizRecordsByCourse[courseId];
    return courseRecords && courseRecords[chapterId] ? courseRecords[chapterId] : null;
}

function hydrateLegacyQuizRecordDetails() {
    let changed = false;
    Object.keys(quizRecordsByCourse || {}).forEach(courseId => {
        const course = getCourseById(Number(courseId));
        const courseRecords = quizRecordsByCourse[courseId];
        if (!course || !courseRecords) return;
        Object.keys(courseRecords).forEach(chapterId => {
            const record = courseRecords[chapterId];
            const quizData = getChapterQuiz(chapterId) || course.quiz || [];
            if (!record || !quizData.length) return;
            const history = getQuizHistory(record);
            history.forEach(attempt => {
                if (Array.isArray(attempt.questionItems) && attempt.questionItems.length) return;
                const answers = attempt.answers || {};
                attempt.questionItems = calculateQuizResult(quizData, answers).questionItems;
                changed = true;
            });
            if (history.length) {
                record.history = history;
                record.questionItems = history[history.length - 1].questionItems;
            }
        });
    });
    if (changed) persistQuizRecords();
}

function getQuizHistory(record) {
    if (!record) return [];
    if (Array.isArray(record.history)) return record.history.slice();
    if (record.completedAt) {
        return [{
            attempt: record.attempts || 1,
            accuracy: record.latestAccuracy || 0,
            correct: record.latestCorrect || 0,
            wrong: record.latestWrong || 0,
            total: record.total || 0,
            elapsedSeconds: record.elapsedSeconds || 0,
            mastery: record.mastery || [],
            answers: Object.assign({}, record.answers || {}),
            completedAt: record.completedAt
        }];
    }
    return [];
}

function getFirstQuizAttempt(record) {
    const history = getQuizHistory(record);
    return history.length ? history[0] : null;
}

function getChapterLearningProgress(course, chapterIndex) {
    if (!course || !course.chapters || !course.chapters[chapterIndex]) return 0;
    const sections = course.chapters[chapterIndex].sections || [];
    if (!sections.length) return 0;
    const done = sections.filter((section, sectionIndex) => isSectionComplete(course, chapterIndex, sectionIndex)).length;
    return Math.round(done / sections.length * 100);
}

function getCourseLearningProgress(course) {
    if (!course || !course.chapters) return 0;
    if (isCourseVideoComplete(course)) return 100;
    let total = 0;
    let done = 0;
    course.chapters.forEach((chapter, chapterIndex) => {
        (chapter.sections || []).forEach((section, sectionIndex) => {
            total++;
            if (isSectionComplete(course, chapterIndex, sectionIndex)) done++;
        });
    });
    const storedProgress = total ? Math.round(done / total * 100) : 0;
    if (storedProgress > 0) return Math.max(storedProgress, course.progress || 0);
    return course.progress || 0;
}

function canEnterChapterQuiz(course, chapterIndex) {
    const chapter = course && course.chapters ? course.chapters[chapterIndex] : null;
    if (!course || !chapter || !getChapterQuiz(chapter.id)) return false;
    if (getChapterQuizRecord(course.id, chapter.id)) return true;
    return isChapterComplete(course, chapterIndex);
}

function findCourseQuizTarget(course, preferRetake) {
    if (!course || !course.chapters) return null;
    const chaptersWithQuiz = course.chapters
        .map((chapter, index) => ({
            chapter,
            index,
            quizData: getChapterQuiz(chapter.id),
            record: getChapterQuizRecord(course.id, chapter.id)
        }))
        .filter(item => !!item.quizData);

    if (!chaptersWithQuiz.length) return null;

    if (preferRetake) {
        const latestRecord = getLatestQuizRecord(course);
        if (latestRecord) {
            const latest = chaptersWithQuiz.find(item => item.chapter.id === latestRecord.chapterId);
            if (latest) return latest;
        }
    }

    const firstNewEligible = chaptersWithQuiz.find(item => !item.record && isChapterComplete(course, item.index));
    if (firstNewEligible) return firstNewEligible;

    const firstRetake = chaptersWithQuiz.find(item => !!item.record);
    if (firstRetake) return firstRetake;

    const firstCompleted = chaptersWithQuiz.find(item => isChapterComplete(course, item.index));
    return firstCompleted || null;
}

function getMasteryState(accuracy) {
    if (accuracy >= 80) return { text: '已掌握', cls: 'mastered' };
    return { text: '需强化', cls: 'weak' };
}

function calculateQuizResult(quizData, answers) {
    let total = quizData.length;
    let correct = 0, wrong = 0;
    let wrongItems = [];
    let questionItems = [];
    let masteryMap = {};

    quizData.forEach((q, index) => {
        const keyword = extractKeyword(q.q, q.explain);
        if (!masteryMap[keyword]) masteryMap[keyword] = { keyword: keyword, total: 0, correct: 0 };
        masteryMap[keyword].total++;
        let userAnswer = answers[q.id];
        let status = 'wrong';

        if (userAnswer === undefined) {
            wrong++;
            userAnswer = -1;
            status = 'wrong';
            wrongItems.push({ ...q, userAnswer, questionNo: index + 1, status });
        } else if (userAnswer === q.correct) {
            correct++;
            masteryMap[keyword].correct++;
            status = 'correct';
        } else {
            wrong++;
            wrongItems.push({ ...q, userAnswer, questionNo: index + 1, status });
        }

        questionItems.push({ ...q, userAnswer, questionNo: index + 1, status, keyword });
    });

    const mastery = Object.keys(masteryMap).map(keyword => {
        const item = masteryMap[keyword];
        const accuracy = Math.round(item.correct / item.total * 100);
        return {
            keyword: keyword,
            total: item.total,
            correct: item.correct,
            accuracy: accuracy,
            state: getMasteryState(accuracy)
        };
    }).sort((a, b) => a.accuracy - b.accuracy);

    return {
        total: total,
        correct: correct,
        wrong: wrong,
        accuracy: total ? Math.round(correct / total * 100) : 0,
        wrongItems: wrongItems,
        questionItems: questionItems,
        mastery: mastery
    };
}

function saveQuizRecord(course, chapterIndex, quizData, answers, elapsedSeconds) {
    const chapter = course && course.chapters ? course.chapters[chapterIndex] : null;
    if (!course || !chapter) return null;
    const result = calculateQuizResult(quizData, answers);
    if (!quizRecordsByCourse[course.id]) quizRecordsByCourse[course.id] = {};
    const previous = quizRecordsByCourse[course.id][chapter.id];
    const previousHistory = getQuizHistory(previous);
    let frontendUser = {};
    try {
        frontendUser = JSON.parse(localStorage.getItem('life_med_user') || '{}') || {};
    } catch (e) {}
    const attempt = {
        attempt: previousHistory.length + 1,
        accuracy: result.accuracy,
        correct: result.correct,
        wrong: result.wrong,
        total: result.total,
        elapsedSeconds: elapsedSeconds || 0,
        mastery: result.mastery,
        answers: Object.assign({}, answers),
        questionItems: result.questionItems,
        studentName: frontendUser.name || '',
        studentGroup: frontendUser.org || frontendUser.role || '',
        completedAt: Date.now()
    };
    const history = previousHistory.concat(attempt);
    const record = {
        chapterId: chapter.id,
        chapterTitle: chapter.title,
        attempts: history.length,
        latestAccuracy: result.accuracy,
        bestAccuracy: history.reduce((best, item) => Math.max(best, item.accuracy || 0), 0),
        latestCorrect: result.correct,
        latestWrong: result.wrong,
        total: result.total,
        elapsedSeconds: elapsedSeconds || 0,
        learningProgress: getChapterLearningProgress(course, chapterIndex),
        mastery: result.mastery,
        answers: Object.assign({}, answers),
        studentName: attempt.studentName,
        studentGroup: attempt.studentGroup,
        questionItems: attempt.questionItems,
        completedAt: attempt.completedAt,
        history: history
    };
    quizRecordsByCourse[course.id][chapter.id] = record;
    persistQuizRecords();
    return record;
}

function getQuizChapterList(course) {
    if (!course || !course.chapters) return [];
    return course.chapters.filter(ch => !!getChapterQuiz(ch.id));
}

function getLatestQuizRecord(course) {
    if (!course || !quizRecordsByCourse[course.id]) return null;
    const records = Object.keys(quizRecordsByCourse[course.id]).map(chapterId => quizRecordsByCourse[course.id][chapterId]);
    if (!records.length) return null;
    return records.sort((a, b) => (b.completedAt || 0) - (a.completedAt || 0))[0];
}

function isCourseQuizPending(course) {
