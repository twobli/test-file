function renderCourseList() {
    const stats = getLearningStats();
    updateOverview(stats);

    const grid = document.getElementById('courseGrid');
    let searchTerm = (document.getElementById('courseSearch').value || '').toLowerCase();
    let filtered = MOCK_COURSES.filter(c => {
        let categoryMatch = (currentCategoryFilter === 'all') ? true : getCourseCategory(c) === currentCategoryFilter;
        let systemMatch = (currentKnowledgeSystemFilter === 'all') ? true : getKnowledgeSystem(c) === currentKnowledgeSystemFilter;
        let typeMatch = (currentFilter === 'all') ? true : c.diseaseType === currentFilter;
        let searchMatch = !searchTerm || c.name.toLowerCase().includes(searchTerm);
        return categoryMatch && systemMatch && typeMatch && searchMatch;
    });

    if (filtered.length === 0) {
        grid.innerHTML = '<div class="empty-state"><div class="empty-icon">📭</div><p>未找到匹配的课程</p></div>';
        return;
    }

    let html = '';
    filtered.forEach(c => {
        let diff = getDifficultyLabel(c.difficulty);
        let btnHtml = '';
        let cardAction = getCourseCardAction(c);
        if (c.progress === 0) {
            btnHtml = '<button class="btn btn-primary btn-sm card-btn" onclick="event.stopPropagation();startLearning(' + c.id + ')">开始学习</button>';
        } else if (isCourseQuizCompleted(c)) {
            btnHtml = '<div class="card-actions">'
                + '<button class="btn btn-primary btn-sm" onclick="event.stopPropagation();continueCourse(' + c.id + ')">再次学习</button>'
                + '<button class="btn btn-success btn-sm" onclick="event.stopPropagation();goCourseQuiz(' + c.id + ')">再次测验</button>'
                + '</div>'
                + '<button class="btn btn-sm card-result-link" onclick="event.stopPropagation();viewResult(' + c.id + ')">查看学习测验结果</button>';
        } else if (isCourseQuizPending(c)) {
            btnHtml = '<div class="card-actions">'
                + '<button class="btn btn-primary btn-sm" onclick="event.stopPropagation();continueCourse(' + c.id + ')">再次学习</button>'
                + '<button class="btn btn-warning btn-sm" onclick="event.stopPropagation();goCourseQuiz(' + c.id + ')">去进行章节测验</button>'
                + '</div>';
        } else {
            btnHtml = '<button class="btn btn-primary btn-sm card-btn" onclick="event.stopPropagation();continueCourse(' + c.id + ')">继续学习</button>';
        }
        const learningProgress = getCourseLearningProgress(c);
        html += `
            <div class="course-card" onclick="${cardAction}">
                <div class="card-cover ${c.coverClass}">${c.icon}</div>
                <div class="card-body">
                    <div class="card-meta">
                        <span class="difficulty-badge ${diff.cls}">难度等级：${diff.text} <span class="stars">${diff.stars}</span></span>
                    </div>
                    <div class="card-title">${c.name}</div>
                    <div class="card-info">
                        <span>⏱ ${c.duration}</span>
                        <span>📑 ${c.chapterCount}章 · ${c.totalSections}节</span>
                    </div>
                    <div class="card-progress">
                        <div class="progress-bar"><div class="progress-bar-fill" style="width:${learningProgress}%;"></div></div>
                        <div class="progress-text">学习进度 ${learningProgress}%</div>
                    </div>
                    ${btnHtml}
                </div>
            </div>`;
    });
    grid.innerHTML = html;
}

