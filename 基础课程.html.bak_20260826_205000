}

function submitQuiz() {
    const course = getCourseById(currentQuizCourseId);
    if (!course) return;
    let unanswered = currentQuizData.length - Object.keys(quizAnswers).length;
    if (unanswered > 0) {
        alert('还有 ' + unanswered + ' 道题未作答，请完成全部题目后再提交。');
        return;
    }
    document.getElementById('modalSubmitMsg').textContent = '提交后将生成查缺补漏分析。';
    document.getElementById('modalSubmitConfirm').style.display = 'flex';
}

function confirmSubmitQuiz() {
    closeModal('modalSubmitConfirm');
    const course = getCourseById(currentQuizCourseId);
    if (!course) return;
    let elapsed = Math.round((Date.now() - quizStartTime) / 1000);
    const record = saveQuizRecord(course, currentQuizChapterIndex, currentQuizData, quizAnswers, elapsed);
    if (getQuizChapterList(course).length && getQuizChapterList(course).every(ch => !!getChapterQuizRecord(course.id, ch.id))) {
        course.quizStatus = 'completed';
    } else if (course.quizStatus === 'locked') {
        course.quizStatus = 'pending';
    }
    const history = getQuizHistory(record);
    const latestAttempt = history[history.length - 1];
    showResultPage(course.name, currentQuizData, elapsed, record, latestAttempt);
}

