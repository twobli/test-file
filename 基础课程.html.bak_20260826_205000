function getLearningStats() {
    let totalAllSections = 0, doneAllSections = 0;
    MOCK_COURSES.forEach(c => { totalAllSections += c.totalSections; doneAllSections += Math.round(c.totalSections * c.progress / 100); });
    let firstAttemptCount = 0;
    let accuracySum = 0;
    let bestAccuracy = 0;
    MOCK_COURSES.forEach(course => {
        const records = quizRecordsByCourse[course.id] || {};
        Object.keys(records).forEach(chapterId => {
            const record = records[chapterId];
            const firstAttempt = getFirstQuizAttempt(record);
            if (!firstAttempt) return;
            firstAttemptCount++;
            accuracySum += firstAttempt.accuracy || 0;
            bestAccuracy = Math.max(bestAccuracy, firstAttempt.accuracy || 0);
        });
    });
    if (!firstAttemptCount) {
        firstAttemptCount = 6;
        accuracySum = 426;
        bestAccuracy = 82;
    }
    const firstAverageAccuracy = firstAttemptCount ? Math.round(accuracySum / firstAttemptCount) : 0;
    return {
        learnedSections: doneAllSections,
        totalSections: totalAllSections,
        unlearnedSections: Math.max(totalAllSections - doneAllSections, 0),
        learningPct: totalAllSections ? Math.round(doneAllSections / totalAllSections * 100) : 0,
        quizFirstAccuracy: firstAverageAccuracy,
        quizFirstAverageAccuracy: firstAverageAccuracy,
        quizFirstBestAccuracy: bestAccuracy,
        quizFirstAttemptCount: firstAttemptCount
    };
}

