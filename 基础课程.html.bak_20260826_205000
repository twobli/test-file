function returnToCurrentCourseContent() {
    const course = getCourseById(currentQuizCourseId || currentCourseId);
    if (!course || !course.chapters || !course.chapters.length) {
        navToCourseList();
        return;
    }

    const chapterIndex = Number.isInteger(currentQuizChapterIndex)
        ? currentQuizChapterIndex
        : (Number.isInteger(currentChapterIndex) ? currentChapterIndex : 0);
    const safeChapterIndex = Math.min(Math.max(chapterIndex, 0), course.chapters.length - 1);
    const chapter = course.chapters[safeChapterIndex];
    const section = chapter.sections && chapter.sections.length
        ? (chapter.sections[currentSectionIndex] || chapter.sections[0])
        : null;

    clearVideoInterval();
    currentCourseId = course.id;
    currentChapterIndex = safeChapterIndex;
    currentSectionIndex = section ? chapter.sections.indexOf(section) : 0;
    currentSectionId = section ? section.id : null;
    showPage('page-video-learning');
    document.getElementById('videoBreadcrumbCourse').textContent = course.name;
    renderChapterTree();
    renderVideoSection();
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function extractKeyword(q, explain) {
    const text = (q || '') + ' ' + (explain || '');
    const keywordRules = [
        { keyword: 'DR国际临床分级标准', patterns: ['DR国际临床分级标准', 'ICDRSS', '临床DR严重程度量表'] },
        { keyword: '4-2-1规则', patterns: ['4-2-1', '四个象限', '静脉串珠', 'IRMA'] },
        { keyword: 'ETDRS分级', patterns: ['ETDRS', '53级'] },
        { keyword: 'DCCT强化血糖控制', patterns: ['DCCT', 'EDIC', '强化血糖', 'HbA1c每降低'] },
        { keyword: 'DR危险因素', patterns: ['危险因素', '病程', 'HbA1c水平', '眼睛颜色'] },
        { keyword: 'DR筛查策略', patterns: ['筛查', '眼底照相', '散瞳', '确诊时'] },
        { keyword: 'OCTA与FFA鉴别', patterns: ['OCTA', '荧光素渗漏', '无创'] },
        { keyword: '血压控制目标', patterns: ['血压控制', 'ADA', '130/80'] },
        { keyword: '房水生成与排出机制', patterns: ['房水', '小梁网', 'Schlemm', 'Na⁺-K⁺-ATP酶'] },
        { keyword: '青光眼视野检查', patterns: ['视野', '旁中心暗点', '鼻侧阶梯', '弓形暗点'] },
        { keyword: 'RNFL厚度评估', patterns: ['RNFL', '颞下', '颞上', '神经纤维层'] },
        { keyword: '抗VEGF治疗机制', patterns: ['抗VEGF', 'VEGF-A', '渗漏'] },
        { keyword: 'FFA判读要点', patterns: ['FFA', '荧光素钠', '臂-视网膜循环', '高荧光', '低荧光'] },
        { keyword: 'AMD发病机制', patterns: ['AMD', 'CNV', '脉络膜新生血管', '干性AMD', '湿性AMD'] },
        { keyword: '高血压视网膜病变分级', patterns: ['KWB', 'Scheie', '棉绒斑', '视盘水肿', '动静脉交叉压迫'] },
        { keyword: 'RVO分类与并发症', patterns: ['BRVO', 'CRVO', 'RVO', '新生血管性青光眼', '筛板'] },
        { keyword: 'OCT结构分层', patterns: ['OCT', '椭圆体带', '中心凹', 'SD-OCT', 'SS-OCT'] },
        { keyword: 'PRP全视网膜光凝', patterns: ['PRP', '全视网膜光凝', '眼底激光', '光热效应'] }
    ];
    const matched = keywordRules.find(rule => rule.patterns.some(pattern => text.includes(pattern)));
    return matched ? matched.keyword : '课程核心概念';
}

