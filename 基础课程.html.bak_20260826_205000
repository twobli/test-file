    if (!course || !course.chapters || !course.chapters.length) return;
    currentCourseId = courseId;
    currentLearningMode = 'video';
    let found = null;
    course.chapters.some((chapter, ci) => chapter.sections.some((section, si) => {
        if (!isSectionComplete(course, ci, si)) {
            found = { ci, si, section };
            return true;
        }
        return false;
    }));
    if (!found) {
        found = { ci: 0, si: 0, section: course.chapters[0].sections[0] };
    }
    currentChapterIndex = found.ci;
    currentSectionIndex = found.si;
    currentSectionId = found.section.id;
    showPage('page-video-learning');
    document.getElementById('videoBreadcrumbCourse').textContent = course.name;
    renderChapterTree();
    renderVideoSection();
}

function goCourseQuiz(courseId) {
    const course = getCourseById(courseId);
    if (!course) return;
    const target = findCourseQuizTarget(course, true);
    if (!target) {
        alert('请先完成任意一个章节的全部视频学习，再进入章节测验。');
        continueCourse(courseId);
        return;
    }
    currentCourseId = courseId;
    currentQuizCourseId = courseId;
    currentChapterIndex = target.index;
    currentQuizChapterIndex = target.index;
    openQuizWithData(course, target.quizData, target.chapter.title);
}

function viewResult(courseId) {
    currentCourseId = courseId;
    currentChapterIndex = 0;
    let course = getCourseById(courseId);
    const latestRecord = getLatestQuizRecord(course);
    if (latestRecord && course && course.chapters) {
        const recordChapterIndex = course.chapters.findIndex(ch => ch.id === latestRecord.chapterId);
        if (recordChapterIndex >= 0) {
            viewChapterResult(courseId, recordChapterIndex);
            return;
        }
    }
    currentQuizCourseId = courseId;
    currentQuizChapterIndex = 0;
    // 模拟最后一次测验结果
    let quizData = course.quiz || [];
    let simulatedAnswers = {};
    quizData.forEach((q, i) => { simulatedAnswers[q.id] = i % 3 === 0 ? q.correct : (q.correct + 1) % 4; });
    quizAnswers = simulatedAnswers;
    showResultPage(course.name, quizData, 725); // ~12分05秒
}

function viewChapterResult(courseId, chapterIndex) {
    const course = getCourseById(courseId);
    const chapter = course && course.chapters ? course.chapters[chapterIndex] : null;
    if (!course || !chapter) return;
    const quizData = getChapterQuiz(chapter.id) || course.quiz || [];
    const record = getChapterQuizRecord(course.id, chapter.id);
    if (!record) {
        viewResult(courseId);
        return;
    }
    currentCourseId = courseId;
    currentChapterIndex = chapterIndex;
    currentQuizCourseId = courseId;
    currentQuizChapterIndex = chapterIndex;
    currentQuizData = quizData;
    const history = getQuizHistory(record);
    const latestAttempt = history[history.length - 1];
    quizAnswers = Object.assign({}, (latestAttempt && latestAttempt.answers) || record.answers || {});
    showResultPage(course.name, quizData, latestAttempt ? latestAttempt.elapsedSeconds : record.elapsedSeconds, record, latestAttempt);
}

function viewQuizAttempt(courseId, chapterIndex, attemptIndex) {
    const course = getCourseById(courseId);
    const chapter = course && course.chapters ? course.chapters[chapterIndex] : null;
    const record = chapter ? getChapterQuizRecord(courseId, chapter.id) : null;
    const history = getQuizHistory(record);
    const attempt = history[attemptIndex];
    if (!course || !chapter || !record || !attempt) return;

    const quizData = getChapterQuiz(chapter.id) || course.quiz || [];
    currentCourseId = courseId;
    currentChapterIndex = chapterIndex;
    currentQuizCourseId = courseId;
    currentQuizChapterIndex = chapterIndex;
    currentQuizData = quizData;
    quizAnswers = Object.assign({}, attempt.answers || {});
    showResultPage(course.name, quizData, attempt.elapsedSeconds, record, attempt);
}

// ==================== 视频学习页 ====================
function renderChapterTree() {
    const course = getCourseById(currentCourseId);
    if (!course) return;
    const tree = document.getElementById('chapterTree');
    let html = '';
    let totalSections = 0, doneSections = 0;
    course.chapters.forEach((ch, ci) => {
        let isOpen = (ci === currentChapterIndex);
        let sectionHtml = '';
        ch.sections.forEach((sec, si) => {
            totalSections++;
            let cls = '';
            let isActive = (sec.id === currentSectionId);
            let isDone = isSectionComplete(course, ci, si);
            if (isActive) cls = 'active';
            if (isDone) {
                cls += ' done';
                doneSections++;
            }
            sectionHtml += `<div class="section-item ${cls}" onclick="selectSection('${sec.id}', ${ci}, ${si})" data-section-id="${sec.id}">${sec.title}</div>`;
        });
        html += `<div class="chapter-node">
            <div class="chapter-title" onclick="toggleChapter(${ci})">
                <span class="expand-icon ${isOpen ? 'open' : ''}">▶</span>${ch.title}
            </div>
            <div class="section-list" style="max-height:${isOpen ? (ch.sections.length * 40) : 0}px;">
                ${sectionHtml}
            </div>
        </div>`;
    });
    tree.innerHTML = html;

    let progressPct = getCourseLearningProgress(course);
    const progressText = document.getElementById('courseProgressText');
    if (progressText) progressText.textContent = progressPct + '%';
    const progressFill = document.getElementById('courseProgressFill');
    if (progressFill) progressFill.style.width = progressPct + '%';
    renderChapterQuizEntry(course);
}

function renderChapterQuizEntry(course) {
    const panel = document.getElementById('chapterQuizPanel');
    if (!panel || !course || currentChapterIndex === null) return;
    const ch = course.chapters[currentChapterIndex];
    const hasQuiz = ch && getChapterQuiz(ch.id);
    const quizRecord = ch ? getChapterQuizRecord(course.id, ch.id) : null;
    const chapterLearned = isChapterComplete(course, currentChapterIndex);
    if (quizRecord) {
        panel.innerHTML = `
            <button class="chapter-quiz-entry" type="button" onclick="startChapterQuiz()">
                <span>📝</span><span>再次进行章节测验</span>
            </button>
            <button class="chapter-quiz-entry secondary" type="button" onclick="viewChapterResult(${course.id}, ${currentChapterIndex})">
                <span>📊</span><span>查看测验结果</span>
            </button>
            <div class="quiz-note">本章学习进度 ${quizRecord ? quizRecord.learningProgress : 100}% · 最近正确率 ${quizRecord ? quizRecord.latestAccuracy : '--'}%</div>
        `;
    } else if (hasQuiz && chapterLearned) {
        panel.innerHTML = `
            <button class="chapter-quiz-entry" type="button" onclick="startChapterQuiz()">
                <span>📝</span><span>去进行章节测验</span>
            </button>
            <div class="quiz-note">${ch.title} 已学完，可进入测验</div>
        `;
    } else {
        panel.innerHTML = `
            <button class="chapter-quiz-entry locked" type="button" onclick="showQuizLockedTip()">
                <span>🔒</span><span>章节测验</span>
            </button>
            <div class="quiz-note">${ch ? ch.title : '当前章节'} 学完后开放</div>
        `;
    }
}

function switchLearningMode(mode) {
    currentLearningMode = 'video';
    const videoPanel = document.getElementById('videoLearningPanel');
    if (videoPanel) videoPanel.classList.add('active');
}

function updateLearningPartStatus() {
    const course = getCourseById(currentCourseId);
    const section = course && currentSectionId ? getSectionCompletionState(course, currentSectionId) : { video: false };
    const videoEl = document.getElementById('videoPartStatus');
    if (videoEl) {
        videoEl.textContent = section.video ? '视频已完成' : '视频未完成';
        videoEl.classList.toggle('done', section.video);
    }
}

function handleArticleScroll() {
    // 已删除的学习模式保留空函数，避免历史事件绑定报错。
}

function toggleChapter(ci) {
    const course = getCourseById(currentCourseId);
    const chapter = course && course.chapters ? course.chapters[ci] : null;
    if (!chapter) return;
    clearVideoInterval();
    currentChapterIndex = ci;
    currentSectionIndex = 0;
    currentLearningMode = 'video';
    currentSectionId = chapter.sections && chapter.sections[0] ? chapter.sections[0].id : null;
    renderChapterTree();
    renderVideoSection();
}

function selectSection(sectionId, ci, si) {
    clearVideoInterval();
    currentSectionId = sectionId;
    currentChapterIndex = ci;
    currentSectionIndex = si;
    // 如果跳到之前已完成的节，标记为done
    renderChapterTree();
    renderVideoSection();
}

function renderVideoSection() {
    const course = getCourseById(currentCourseId);
    if (!course) return;
    let section = null;
    for (let ch of course.chapters) {
        for (let s of ch.sections) {
            if (s.id === currentSectionId) { section = s; break; }
        }
        if (section) break;
    }
    if (!section) return;

    document.getElementById('toolbarCourseTitle').textContent = course.name;
    document.getElementById('toolbarSectionBadge').textContent = section.title;
    switchLearningMode(currentLearningMode);
    updateLearningPartStatus();

    // 视频相关
    resetVideo(section.duration);
    if (isSectionPartComplete(course, currentSectionId, 'video')) {
        videoCurrentTime = videoDuration;
        updateVideoUI();
        document.getElementById('videoHint').textContent = '视频已完成，可再次播放复习';
    }
    const completeHint = document.getElementById('sectionCompleteHint');
    completeHint.style.display = 'none';
    completeHint.innerHTML = `
        <span class="complete-text">✅ 本节视频已完成。</span>
        <button class="btn btn-primary btn-sm" onclick="nextSection()">下一节</button>
    `;

    // 更新章节测验按钮状态
    updateQuizButtonState();
}

function resetVideo(durationStr) {
    clearVideoInterval();
    videoPlaying = false;
    videoCurrentTime = 0;
    let mins = parseInt(durationStr) || 25;
    videoDuration = mins * 60;
    playbackSpeed = 1;
    document.getElementById('currentTime').textContent = '00:00';
    document.getElementById('totalTime').textContent = formatTime(videoDuration);
    document.getElementById('videoProgressFill').style.width = '0%';
    document.getElementById('playBtn').textContent = '▶';
    document.getElementById('videoHint').textContent = '点击播放';
    document.getElementById('ctrlPlayBtn').textContent = '▶';
    document.getElementById('speedBtn').textContent = '1.0x';
}

function togglePlay() {
    if (videoPlaying) { pauseVideo(); }
    else { playVideo(); }
}

function playVideo() {
    if (videoCurrentTime >= videoDuration) {
        videoCurrentTime = 0;
        updateVideoUI();
    }
    videoPlaying = true;
    document.getElementById('playBtn').textContent = '⏸';
    document.getElementById('videoHint').textContent = '播放中...';
    document.getElementById('ctrlPlayBtn').textContent = '⏸';
    videoInterval = setInterval(() => {
        videoCurrentTime += playbackSpeed;
        if (videoCurrentTime >= videoDuration) {
            videoCurrentTime = videoDuration;
            pauseVideo();
            onVideoEnd();
        }
        updateVideoUI();
    }, 1000);
}

function pauseVideo() {
    videoPlaying = false;
    document.getElementById('playBtn').textContent = '▶';
    document.getElementById('videoHint').textContent = '已暂停';
    document.getElementById('ctrlPlayBtn').textContent = '▶';
    clearVideoInterval();
}

function clearVideoInterval() {
    if (videoInterval) { clearInterval(videoInterval); videoInterval = null; }
}

function updateVideoUI() {
    document.getElementById('currentTime').textContent = formatTime(Math.floor(videoCurrentTime));
    let pct = videoDuration > 0 ? (videoCurrentTime / videoDuration * 100) : 0;
    document.getElementById('videoProgressFill').style.width = pct + '%';
}

function onVideoEnd() {
    document.getElementById('videoHint').textContent = '播放完成';
    const course = getCourseById(currentCourseId);
    if (course && currentSectionId) markSectionPartComplete(course, currentSectionId, 'video');
    updateLearningPartStatus();
    renderChapterTree();
    checkSectionLearningComplete(course);
}

function checkSectionLearningComplete(course) {
    if (!course || !currentSectionId) return;
    const hint = document.getElementById('sectionCompleteHint');
    const state = getSectionCompletionState(course, currentSectionId);
    if (state.video) {
        hint.style.display = 'flex';
        hint.innerHTML = `
            <span class="complete-text">✅ 本节视频已完成。你可以继续学习任意章节，完成本章全部小节后开放章节测验。</span>
            <button class="btn btn-primary btn-sm" onclick="nextSection()">下一节</button>
        `;
        checkLastSection(course);
    } else {
        hint.style.display = 'flex';
        hint.innerHTML = `
            <span class="complete-text">当前小节尚未完成：请完整播放视频。</span>
            <button class="btn btn-outline btn-sm" onclick="switchLearningMode('video')">去看视频</button>
        `;
    }
}

function changeSpeed() {
    const speeds = [0.5, 1.0, 1.5, 2.0];
    let idx = speeds.indexOf(playbackSpeed);
    idx = (idx + 1) % speeds.length;
    playbackSpeed = speeds[idx];
    document.getElementById('speedBtn').textContent = playbackSpeed.toFixed(1) + 'x';
}

function checkLastSection(course) {
    if (!course) return;
    let ch = course.chapters[currentChapterIndex];
    if (!ch) return;
    let lastSec = ch.sections[ch.sections.length - 1];
    if (currentSectionId === lastSec.id && isChapterComplete(course, currentChapterIndex)) {
        document.getElementById('sectionCompleteHint').style.display = 'flex';
        document.getElementById('sectionCompleteHint').innerHTML = `
            <span class="complete-text">✅ 你已完成本章节（${ch.title}）的学习，是否进行章节测验？</span>
            <button class="btn btn-primary btn-sm" onclick="startChapterQuiz()">立即测验</button>
        `;
    }
}

function nextSection() {
    const course = getCourseById(currentCourseId);
    if (!course) return;
    // 在当前章内查找下一节
    let ch = course.chapters[currentChapterIndex];
    if (currentSectionIndex + 1 < ch.sections.length) {
        let nextSec = ch.sections[currentSectionIndex + 1];
        document.getElementById('sectionCompleteHint').style.display = 'none';
        selectSection(nextSec.id, currentChapterIndex, currentSectionIndex + 1);
    } else {
        // 当前章最后一节完成，按本章学习完成状态提示
        document.getElementById('sectionCompleteHint').style.display = 'flex';
        if (isChapterComplete(course, currentChapterIndex)) {
            document.getElementById('sectionCompleteHint').innerHTML = `
                <span class="complete-text">✅ 你已完成本章节（${ch.title}）的学习，是否进行章节测验？</span>
                <button class="btn btn-primary btn-sm" onclick="startChapterQuiz()">立即测验</button>
            `;
        } else {
            document.getElementById('sectionCompleteHint').innerHTML = `
                <span class="complete-text">本章还有视频未完成，你可以在目录中自由选择任意章节继续学习。</span>
                <button class="btn btn-outline btn-sm" onclick="switchLearningMode('video')">继续学习</button>
            `;
        }
    }
}

